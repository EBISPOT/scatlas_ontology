    <!-- http://purl.obolibrary.org/obo/CL_0000235 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000235">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000113"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000145"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000766"/>
        <obo:IAO_0000115>A mononuclear phagocyte present in variety of tissues, typically differentiated from monocytes, capable of phagocytosing a variety of extracellular particulate material, including immune complexes, microorganisms, and dead cells.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref>BTO:0000801</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-0587</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:63261</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:83585</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D008264</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009141</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>histiocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#blood_and_immune_upper_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
