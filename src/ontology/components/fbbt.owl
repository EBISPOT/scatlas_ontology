        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>salivary gland</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005382"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Paired secretory organ connected to the atrium via the salivary duct. It is essentially composed of two cell types: cuboidal epithelial duct cells that form tubes connecting the secretory cells to the larval mouth; and secretory cells that synthesize and secrete high levels of protein (Andrew et al., 2000).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0064792</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0126988</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FBbt_00005383 -->

