        <oboInOwl:hasRelatedSynonym>cardiac orifice</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cardiac region</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cardial orifice</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001162</oboInOwl:id>
