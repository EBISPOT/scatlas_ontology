        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002063"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Part of the circulatory system which receives blood from the systemic veins and contracts to pump the blood into the atrium of the heart.[AAO]</owl:annotatedTarget>
