    <!-- http://purl.obolibrary.org/obo/UBERON_0001991 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001991">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001807"/>
        <obo:IAO_0000115>The cervical ganglia are paravertebral ganglia of the sympathetic nervous system. They consist of three paravertebral ganglia: superior cervical ganglion middle cervical ganglion inferior cervical ganglion. The inferior ganglion may be fused with the first thoracic ganglion to form a single structure, the stellate ganglion. Nerves emerging from cervical sympathetic ganglia contribute to the cardiac plexus, among other things. [WP,unvetted].</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref>BTO:0000113</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:18438</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:6470</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0001153</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:181100007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Cervical_ganglion</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cervical sympathetic ganglion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>UBERON:0001991</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:label>cervical ganglion</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/e/e1/Gray844.png</foaf:depiction>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001991"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The cervical ganglia are paravertebral ganglia of the sympathetic nervous system. They consist of three paravertebral ganglia: superior cervical ganglion middle cervical ganglion inferior cervical ganglion. The inferior ganglion may be fused with the first thoracic ganglion to form a single structure, the stellate ganglion. Nerves emerging from cervical sympathetic ganglia contribute to the cardiac plexus, among other things. [WP,unvetted].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Cervical_ganglion</oboInOwl:hasDbXref>
    </owl:Axiom>
    


