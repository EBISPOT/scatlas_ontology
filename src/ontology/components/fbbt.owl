    <!-- http://purl.obolibrary.org/obo/FBbt_00003788 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00003788">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007578"/>
        <obo:IAO_0000028>Tm</obo:IAO_0000028>
        <obo:IAO_0000115>An intrinsic columnar neuron of the optic lobe whose cell body lies in the distal cortex of the medulla and that projects through the medulla and optic chiasm into the lobula. All neurons arborize in the lobula and most, but not all, in the medulla (Fischbach and Dittrich, 1989).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>VFB:FBbt_00003788</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Tm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Tm neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00003788</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>transmedullary neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003788"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000028"/>
        <owl:annotatedTarget>Tm</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0247762</oboInOwl:hasDbXref>
    </owl:Axiom>
