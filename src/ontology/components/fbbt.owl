        <oboInOwl:hasDbXref>FlyBase:FBrf0237706</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0252485</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004225"/>
