    <!-- http://purl.obolibrary.org/obo/FBbt_00067056 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00067056">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002167"/>
