        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>
        <rdfs:comment>at this time we have no need to name a more specific &apos;pelvic fin bud&apos; class, but we may in future</rdfs:comment>
        <rdfs:label>pelvic appendage bud</rdfs:label>
    </owl:Class>
