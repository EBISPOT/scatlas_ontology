        <rdfs:label>dura mater</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/8/8e/Meninges-en.svg</foaf:depiction>
