        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:comment>The mouse parotid, exorbital lacrimal gland and exocrine pancreas have similar histological appearances[ISBN:0123813611]</rdfs:comment>
        <rdfs:label>parotid gland</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/5/51/Illu_quiz_hn_02.jpg</foaf:depiction>
    </owl:Class>
