        <oboInOwl:hasExactSynonym>ionotropic receptor neuron Ir75d</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00047054</oboInOwl:id>
        <rdfs:label>adult olfactory receptor neuron Ir75d</rdfs:label>
    </owl:Class>
