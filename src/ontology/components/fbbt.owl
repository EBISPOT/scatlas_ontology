    <!-- http://purl.obolibrary.org/obo/FBbt_00049283 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00049283">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100318"/>
        <obo:IAO_0000115>Cell of the adult proventriculus that is part of the midgut (King, 1988). These cells make up the anterior part of the intermediate layer and the outer layer of the proventriculus and they secrete the second to fourth layers of the peritrophic membrane (King, 1988).</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-20T08:48:48Z</terms:date>
