        <oboInOwl:hasDbXref>MA:0000120</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MAT:0000075</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D010179</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIAA:0000075</oboInOwl:hasDbXref>
