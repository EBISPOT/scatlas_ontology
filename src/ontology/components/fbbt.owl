        <oboInOwl:hasExactSynonym>syncytiotrophoblastic cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>plasmidotrophoblast cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>syntrophoblast cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>syncytiotrophoblast cell</rdfs:label>
        <rdfs:seeAlso>https://github.com/obophenotype/cell-ontology/issues/2100</rdfs:seeAlso>
    </owl:Class>
    <owl:Axiom>
