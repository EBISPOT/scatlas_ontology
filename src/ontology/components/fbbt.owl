        <oboInOwl:hasDbXref>HBA:4010</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C33393</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0152299</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Precentral_gyrus</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:89</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>precentral convolution</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>prerolandic gyrus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
