        <oboInOwl:hasRelatedSynonym>mushroom body DA neuron</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00049839</oboInOwl:id>
        <rdfs:label>adult dopaminergic mushroom body input neuron</rdfs:label>
