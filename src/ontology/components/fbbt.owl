    <!-- http://purl.obolibrary.org/obo/UBERON_0001716 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001716">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007375"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010313"/>
        <obo:IAO_0000115>The part of the palate formed from the fusion of the two palatine shelves, extensions of the maxillary prominences.</obo:IAO_0000115>
        <obo:UBPROP_0000007>palatal</obo:UBPROP_0000007>
        <obo:UBPROP_0000008>present in mammals and some reptiles. A similar structure is found in crocodilians, but, in most other tetrapods, the oral and nasal cavities are not truly separate. The secondary palate is formed by bilateral medial extensions of maxillary processes. The extensions (palatine processes) meet at the midline, merging dorsally with nasal septum and rostrally with primary palate. The secondary palate (hard palate) separates nasal and oral cavities. Caudal extension of the secondary palate into the pharynx, forms a soft palate which divides the rostral pharynx into dorsal (nasopharynx) and ventral (oropharynx) chamber.</obo:UBPROP_0000008>
        <obo:UBPROP_0000009>separates respiratory and oral passages</obo:UBPROP_0000009>
        <oboInOwl:hasBroadSynonym>palate</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>palatum</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>BTO:0001779</oboInOwl:hasDbXref>
