        <oboInOwl:hasExactSynonym>melanotrope</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>melanotroph</oboInOwl:hasExactSynonym>
        <rdfs:label>melanocyte stimulating hormone secreting cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000440"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
