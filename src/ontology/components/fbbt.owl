    <!-- http://purl.obolibrary.org/obo/CL_0000125 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000125">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000095"/>
        <obo:IAO_0000115>A non-neuronal cell of the nervous system. They not only provide physical support, but also respond to injury, regulate the ionic and chemical composition of the extracellular milieu. Guide neuronal migration during development, and exchange metabolites with neurons.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref>BTO:0002606</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-0415</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FBbt:00005144</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:54536</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009073</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>neuroglial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>neuroglia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#general_cell_types_upper_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:comment>Not all glial cells develop from glioblasts, with microglia developing from the mesoderm instead. See https://github.com/obophenotype/cell-ontology/issues/1571</rdfs:comment>
        <rdfs:label>glial cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
