    <!-- http://purl.obolibrary.org/obo/FBbt_00004173 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00004173">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004172"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005158"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005184"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00052000"/>
        <obo:IAO_0000115>Olfactory sensillum of antennal segment 3 whose external sensory part is a sharply pointed hair arising from a conspicuous cylindrical base. The walls of the hair are perforated by irregularly distributed pores connecting to a lymph filled lumen containing 1-3 ORN dendrites, unbranched except occasionally near the hair tip.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>VFB:FBbt_00004173</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>sensillum trichodeum of antennal segment 3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>antennal trichoid sensillum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>at</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00004173</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#hidden_assertion"/>
        <rdfs:comment>Morphology is consistent with these sensilla being olfactory (Shanbhag et al., 1999). This function has been directly confirmed by electrophysiology (Clyne et al., 1997).</rdfs:comment>
        <rdfs:label>trichoid sensillum of antennal segment 3</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004173"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Olfactory sensillum of antennal segment 3 whose external sensory part is a sharply pointed hair arising from a conspicuous cylindrical base. The walls of the hair are perforated by irregularly distributed pores connecting to a lymph filled lumen containing 1-3 ORN dendrites, unbranched except occasionally near the hair tip.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0104820</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0128642</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004173"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>antennal trichoid sensillum</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0219809</oboInOwl:hasDbXref>
    </owl:Axiom>
