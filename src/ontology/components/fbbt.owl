        <oboInOwl:hasDbXref>HAO:0000101</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MAT:0000086</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIAA:0000086</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TGMA:0000007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Antenna_(biology)</oboInOwl:hasDbXref>
