    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001159">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000168"/>
        <obo:IAO_0000115>The part of the large intestine that is closest to the rectum and anus. It forms a loop that averages about 40 cm. in length, and normally lies within the pelvis, but on account of its freedom of movement it is liable to be displaced into the abdominal cavity.</obo:IAO_0000115>
