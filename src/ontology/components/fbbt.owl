        <oboInOwl:hasDbXref>UMLS:C0929301</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000398</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Mammary_gland</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>glandula mammaria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lactiferous gland</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>lobe of breast</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>milk patch</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
