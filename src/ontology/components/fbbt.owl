    <!-- http://purl.obolibrary.org/obo/UBERON_0001729 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001729">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004119"/>
