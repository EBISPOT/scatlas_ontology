    <!-- http://purl.obolibrary.org/obo/FBbt_00007368 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00007368">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005106"/>
        <obo:IAO_0000115>A neuron that uses a biogenic amine as its neurotransmitter (Vomel and Wegener, 2008; Fuchs et al., 2014).</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-07-13T04:06:57Z</terms:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00007368</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00007368</oboInOwl:id>
        <rdfs:comment>Strictly speaking, &quot;aminergic&quot; should refer to any type of amine being used as a neurotransmitter. However, the term is most commonly used to refer to biogenic amines only, which is the meaning we retain here. See https://github.com/geneontology/go-ontology/issues/21625.</rdfs:comment>
        <rdfs:label>aminergic neuron</rdfs:label>
    </owl:Class>
