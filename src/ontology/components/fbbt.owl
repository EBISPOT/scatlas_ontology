        <oboInOwl:hasDbXref>UMLS:C0009194</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Coccyx</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Coccyx</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>coccygeal skeleton</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>coccygeal vertebrae I-IV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>coccyx [coccygeal vertebrae I-IV]</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>coccyx [vertebrae coccygeae I-IV]</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fused caudal vertebrae</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fused caudal vertebral column</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>os coccygis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
