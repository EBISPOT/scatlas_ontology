    <!-- http://purl.obolibrary.org/obo/CL_0000560 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000560">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000096"/>
        <obo:IAO_0000115>A late neutrophilic metamyelocyte in which the nucleus is indented to more than half the distance to the farthest nuclear margin but in no area being condensed to a single filament. The nucleus is in the form of a curved or coiled band, not having acquired the typical multilobar shape of the mature neutrophil. These cells are fMLP receptor-positive, CD11b-positive, CD35-negative, and CD49d-negative.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>band</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>band cell</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>band form</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>stab cell</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>ZFA:0009254</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>rod neutrophil</oboInOwl:hasExactSynonym>
        <rdfs:comment>Found in the Band 1 fraction.</rdfs:comment>
        <rdfs:label>band form neutrophil</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000560"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A late neutrophilic metamyelocyte in which the nucleus is indented to more than half the distance to the farthest nuclear margin but in no area being condensed to a single filament. The nucleus is in the form of a curved or coiled band, not having acquired the typical multilobar shape of the mature neutrophil. These cells are fMLP receptor-positive, CD11b-positive, CD35-negative, and CD49d-negative.</owl:annotatedTarget>
