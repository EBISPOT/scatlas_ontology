    <!-- http://purl.obolibrary.org/obo/FBbt_00057175 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00057175">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005310"/>
        <obo:IAO_0000115>A spermatid which has initiated axoneme elongation, but which is relatively short (up to 200 micrometers in length) and retains a round nucleus. The two parts of the mitochondrial derivative are roughly equal in size.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://www.wikidata.org/entity/Q3074571"/>
