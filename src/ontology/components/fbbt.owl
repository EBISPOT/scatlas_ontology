        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0001019"/>
        <obo:IAO_0000115>Common dendritic precursor is a hematopoietic progenitor cell that is CD117-low, CD135-positive, CD115-positive and lacks plasma membrane parts for hematopoietic lineage markers.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>CDP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>common dendritic precursor</oboInOwl:hasExactSynonym>
