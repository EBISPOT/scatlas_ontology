        <oboInOwl:hasRelatedSynonym>presumptive somite mesoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>somitogenic mesoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>somitomeric mesoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>unsegmented mesenchyme</oboInOwl:hasRelatedSynonym>
