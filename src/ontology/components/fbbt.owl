        <oboInOwl:hasDbXref>Wikipedia:Nasal_concha</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ossified nasal turbinal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ossified nasal turbinate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ossified turbinate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>turbinal bone</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>turbinate bone</oboInOwl:hasExactSynonym>
