        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The vesicular gland is part of the male reproductive system. The vesicular gland contributes fluids, energy substrates, and buffers to semen. It can be found near the Coagulating gland, which also belongs to the reproductive system.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>BTO:0003717</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007194"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000008"/>
        <owl:annotatedTarget>bipartite seminal vesicles, with a seminal gland and vesicular gland sharing a common duct are found in lagomorphs</owl:annotatedTarget>
        <oboInOwl:source>Lombardi</oboInOwl:source>
    </owl:Axiom>
    


