    <!-- http://purl.obolibrary.org/obo/UBERON_0004024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002050"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004023"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A distinct elevation of a transient proliferating cell mass of the fetal subventricular zone; this mass contributes most of its cells to the neocortex; however, hippocampal neurons, thalamus, septum and olfactory bulb neurons are also partly derived from the MGE.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>MGE</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>DHBA:10550</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:37471</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PBA:128012834</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>UBERON:0004024</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>medial ganglionic eminence</rdfs:label>
    </owl:Class>
