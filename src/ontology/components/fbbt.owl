        <rdfs:label>hindbrain</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/5/54/EmbryonicBrain.svg</foaf:depiction>
