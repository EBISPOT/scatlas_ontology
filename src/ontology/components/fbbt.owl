    <!-- http://purl.obolibrary.org/obo/FBbt_00005090 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00005090">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007325"/>
        <obo:IAO_0000115>Epidermal cell that forms part of one end a muscle and connects it to an attachment site (Schweitzer et al., 2010). It attaches to a muscle cell via a myotendinous junction composed of hemiadherens junctions and extracellular matrix (Schweitzer et al., 2010). The attachment of the tendon cell to the cuticle relies on interdigitating hemidesmosomes in this cell that are closely associated with tonofibrils embedded in the cuticle.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>EMA cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>epidermal muscle attachment cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tenocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00005090</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#scrnaseq_slim"/>
        <rdfs:label>tendon cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005090"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Epidermal cell that forms part of one end a muscle and connects it to an attachment site (Schweitzer et al., 2010). It attaches to a muscle cell via a myotendinous junction composed of hemiadherens junctions and extracellular matrix (Schweitzer et al., 2010). The attachment of the tendon cell to the cuticle relies on interdigitating hemidesmosomes in this cell that are closely associated with tonofibrils embedded in the cuticle.</owl:annotatedTarget>
