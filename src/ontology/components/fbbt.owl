        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#location_grouping"/>
        <rdfs:label>transit amplifying cell of small intestine</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0009012"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A rapidly proliferating population of cells that differentiate from stem cells of the intestinal crypt of the small intestine. Stem cells located in the crypts of Lieberkühn give rise to proliferating progenitor or transit amplifying cells that differentiate into the four major epithelial cell types. These include columnar absorptive cells or enterocytes, mucous secreting goblet cells, enteroendocrine cells and paneth cells.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:20801415</oboInOwl:hasDbXref>
