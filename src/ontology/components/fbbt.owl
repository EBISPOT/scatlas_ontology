            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001278"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Columnar cell which populate the epithelium of large intestine and absorb water. This cell is the most numerous of the epithelial cell types in the large intestine; bear apical microvilli, contain secretory granules in their apical cytoplasm; secretion appears to be largely mucins, but is also rich in antibodies of the IgA type.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-06-29T11:07:25Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>columnar cell</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>BTO:0002484</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:63638</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:66771</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>columnar cell of the colon</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vacuolar absorptive cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>enterocyte of epithelium of large intestine</rdfs:label>
    </owl:Class>
