    <!-- http://purl.obolibrary.org/obo/FBbt_00100525 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00100525">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00058224"/>
        <obo:IAO_0000115>Glial cell of the adult fly that is located in the optic chiasm (Tix et al., 1997). Members of this group of glial cells are arranged in rows between successive dorsoventral sheets of intercrossing fibers of the outer and inner chiasmata (Edwards and Meinertzhagen, 2010; Tix et al., 1997).</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://www.researchgate.net/scientific-contributions/Simon-Reeve-2162827703"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-05-23T01:49:16Z</terms:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00100525</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>adult XG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult optic chiasm glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>giant glial cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00100525</oboInOwl:id>
        <rdfs:comment>Kremer et al. (2017) expression analysis suggests that these are types of ensheathing glia - inner tract glia likely to be synaptic neuropil ensheathing, outer tract glia likely to be tract neuropil ensheathing - https://orcid.org/0000-0002-1373-1705.</rdfs:comment>
        <rdfs:label>adult optic chiasma glial cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100525"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Glial cell of the adult fly that is located in the optic chiasm (Tix et al., 1997). Members of this group of glial cells are arranged in rows between successive dorsoventral sheets of intercrossing fibers of the outer and inner chiasmata (Edwards and Meinertzhagen, 2010; Tix et al., 1997).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0096428</oboInOwl:hasDbXref>
