        <oboInOwl:hasRelatedSynonym>subependymal zone</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0004922</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>postnatal subventricular zone</rdfs:label>
    </owl:Class>
