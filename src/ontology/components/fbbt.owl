    <!-- http://purl.obolibrary.org/obo/UBERON_0001986 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001986">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000487"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012275"/>
        <obo:IAO_0000115>A layer of epithelium that lines the heart, blood vessels (endothelium, vascular), lymph vessels (endothelium, lymphatic), and the serous cavities of the body[MESH]. Simple squamous epithelium which lines blood and lymphatic vessels and the heart[FMA].</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000007>endothelial</obo:UBPROP_0000007>
        <oboInOwl:hasDbXref>BTO:0000393</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-0278</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EFO:0002548</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:63916</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:520</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D004727</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12481</oboInOwl:hasDbXref>
