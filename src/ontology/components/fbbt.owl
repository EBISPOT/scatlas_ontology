    <!-- http://purl.obolibrary.org/obo/FBbt_00067010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00067010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004173"/>
        <obo:IAO_0000115>Olfactory trichoid sensillum of antennal segment 3 that houses the dendrites of ORNs Or47b and Or88a, with a subset additionally housing an ORN Or65a dendrite (Grabe et al., 2016; Gonzales et al., 2021). There are more of these sensilla in males than females (Grabe et al, 2016).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>VFB:FBbt_00067010</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
