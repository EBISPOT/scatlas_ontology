        <oboInOwl:hasDbXref>PBA:10094</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:1163</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>nucleus accumbens shell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>shell of nucleus accumbens</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>shell region of nucleus accumbens</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>accumbens nucleus shell</oboInOwl:hasRelatedSynonym>
