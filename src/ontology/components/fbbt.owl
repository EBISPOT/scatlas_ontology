    <!-- http://purl.obolibrary.org/obo/FBbt_00004211 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00004211">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000210"/>
