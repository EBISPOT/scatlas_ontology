    <!-- http://purl.obolibrary.org/obo/FBbt_00057014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00057014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00058261"/>
        <obo:IAO_0000115>Epithelial cell of the terminal epithelium of the testis. These cells engulf the head cyst cell of a spermatid cyst during coiling, so anchoring the head of the coiling spermatid. These cells also phagocytose the waste bags and cyst cells left over at the end of spermatogenesis.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-06-16T01:59:36Z</terms:date>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00057014</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#FlyTed"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>terminal epithelial cell of testis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00057014"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Epithelial cell of the terminal epithelium of the testis. These cells engulf the head cyst cell of a spermatid cyst during coiling, so anchoring the head of the coiling spermatid. These cells also phagocytose the waste bags and cyst cells left over at the end of spermatogenesis.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0024468</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0064778</oboInOwl:hasDbXref>
