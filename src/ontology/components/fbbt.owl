    <!-- http://purl.obolibrary.org/obo/CL_1001106 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_1001106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_1000504"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_1001016"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001291"/>
            </owl:Restriction>
