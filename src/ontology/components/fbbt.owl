    <!-- http://purl.obolibrary.org/obo/FBbt_00111282 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00111282">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0011005"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003702"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003832"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00049542"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00058207"/>
        <obo:IAO_0000028>Pm4</obo:IAO_0000028>
        <obo:IAO_0000115>Proximal medullary amacrine neuron that branches at the proximal surface of the medulla, in medulla layers M8 and M9. Its arbor covers around 11 columns. It occupies a central intracolumnar position. It is GABAergic (Davis et al., 2020). There are around 60 Pm4 neurons per hemisphere.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-5948-3092"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2015-11-10T14:48:20Z</terms:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00111282</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Pm4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00111282</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>proximal medullary amacrine neuron Pm4</rdfs:label>
    </owl:Class>
    <owl:Axiom>
