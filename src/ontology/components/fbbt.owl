    <!-- http://purl.obolibrary.org/obo/FBbt_00100506 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00100506">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007597"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00058251"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100500"/>
        <obo:IAO_0000115>Small, oblong-shaped glial cell that is part of the (outer) perineurial sheath layer on the surface of the adult brain. It is located on top of the basal glial cell layer that is composed of the subperineurial glial cells.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://www.researchgate.net/scientific-contributions/Simon-Reeve-2162827703"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-04-27T11:05:54Z</terms:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00100506</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>adult brain PNG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00100506</oboInOwl:id>
        <rdfs:comment>The perineurial glial cells develop post-embryonically, in a non-GCM manner, and are thus likely to function only in the blood-brain-barrier of the adult (Edwards and Meinertzhagen, 2010).</rdfs:comment>
        <rdfs:label>adult brain perineurial glial cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100506"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Small, oblong-shaped glial cell that is part of the (outer) perineurial sheath layer on the surface of the adult brain. It is located on top of the basal glial cell layer that is composed of the subperineurial glial cells.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0206543</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0210316</oboInOwl:hasDbXref>
