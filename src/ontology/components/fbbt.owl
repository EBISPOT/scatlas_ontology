        <oboInOwl:hasRelatedSynonym>lobe of mammary gland</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>mamma</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>mammae</oboInOwl:hasRelatedSynonym>
