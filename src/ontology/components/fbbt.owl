    <!-- http://purl.obolibrary.org/obo/FBbt_00047054 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00047054">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00049980"/>
