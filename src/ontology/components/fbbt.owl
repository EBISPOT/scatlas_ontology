    <!-- http://purl.obolibrary.org/obo/UBERON_0001532 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001532">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003496"/>
