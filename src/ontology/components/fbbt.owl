    <!-- http://purl.obolibrary.org/obo/FBbt_00048490 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00048490">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_10000000"/>
        <obo:IAO_0000115>Anatomical entity of the male that is not found in the same form in the female. If there is a counterpart in the female, the male and female types are substantially different.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-11T10:56:10Z</terms:date>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00048490</oboInOwl:id>
        <rdfs:comment>For example, the testis is male-specific since it is substantially different to the ovary, which may be considered to be the female-specific counterpart. A male wing is not substantially different to a female wing, so is not considered male-specific.</rdfs:comment>
        <rdfs:label>male-specific anatomical entity</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00048490"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Anatomical entity of the male that is not found in the same form in the female. If there is a counterpart in the female, the male and female types are substantially different.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-1373-1705</oboInOwl:hasDbXref>
    </owl:Axiom>
    


