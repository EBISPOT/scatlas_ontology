    <!-- http://purl.obolibrary.org/obo/FBbt_00005402 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00005402">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004904"/>
        <obo:IAO_0000115>Follicle cell that overlies the oocyte (Wu et al., 2008). Along with the posterior terminal follicle cells they form a columnar epithelium from stage 10, which deposits eggshell components (Wu et al., 2008). These cells are connected to one another by ring canals (Airoldi et al., 2011).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>MBFC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>central main body follicle cell</oboInOwl:hasExactSynonym>
