    <!-- http://purl.obolibrary.org/obo/UBERON_0035612 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0035612">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010363"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001025"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001707"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A skeletal element of the ethmoid region with complex morphology that are lined with mucuous membranes involved in either olfaction or air conditioning.</obo:IAO_0000115>
        <obo:IAO_0000116>consult http://www.ncbi.nlm.nih.gov/pubmed/25312359 to add missing structures, e.g. ectoturbinals</obo:IAO_0000116>
        <obo:UBPROP_0000008>unossified in dinosaurs[http://palaeos.com/vertebrates/bones/braincase/ethmoid.html]</obo:UBPROP_0000008>
        <oboInOwl:hasExactSynonym>nasal turbinal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>nasal turbinal element</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>nasal turbinate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>turbinal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>turbinate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
