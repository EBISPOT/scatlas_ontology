    <!-- http://purl.obolibrary.org/obo/CL_0000581 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000581">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000864"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001025"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001179"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A macrophage resident in the peritoneum under non-inflammatory conditions. Markers include F4/80-high, CD11b-high, CD68-positive, SIGNR1-positive, CD115-high, MHC-II-negative, and Dectin-1-positive.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0001034</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:83025</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009267</oboInOwl:hasDbXref>
        <rdfs:comment>Markers: Mouse: F4/80-high, CD11b-high, CD68+, SIGNR1+, Dectin-1+.</rdfs:comment>
        <rdfs:label>peritoneal macrophage</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000581"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A macrophage resident in the peritoneum under non-inflammatory conditions. Markers include F4/80-high, CD11b-high, CD68-positive, SIGNR1-positive, CD115-high, MHC-II-negative, and Dectin-1-positive.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MESH:D017737</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:15771589</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:19201820</oboInOwl:hasDbXref>
