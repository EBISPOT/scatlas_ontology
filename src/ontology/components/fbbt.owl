        <oboInOwl:id>FBbt:00100502</oboInOwl:id>
        <rdfs:label>adult neuropil glial cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100502"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Glial cell of the adult that is associated with a neuropil of the brain. There are approximately 200 neuropil associated glial cells per hemisphere of the adult brain (Hartenstein, 2011).</owl:annotatedTarget>
