    <!-- http://purl.obolibrary.org/obo/FBbt_00003821 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00003821">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003817"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00049541"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00058205"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00110137"/>
        <obo:IAO_0000028>TmY4</obo:IAO_0000028>
        <obo:IAO_0000115>Transmedullary Y wide-field neuron that terminates with both fine and bleb-type arborizations in lobula layer 4 and in lobula plate layers 2, 3 and 4, but shows only fine arborizations in lobula plate layer 1. It displays both fine and bleb-type arborizations in medulla layer M8, but has only fine arborizations in medulla layer M3 and M4 (Morante and Desplan, 2008; Fischbach and Dittrich, 1989). It is cholinergic (Konstantinides et al., 2022).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FlyBrain_NDB:10172</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VFB:FBbt_00003821</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>TmY4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00003821</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:comment>Pre- versus postsynaptic innervation judged by scoring of terminal morphology from figures in Fischbach and Dittrich (1989) as assessed by FlyBrain Neuron DB.</rdfs:comment>
        <rdfs:label>transmedullary Y neuron TmY4</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003821"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000028"/>
        <owl:annotatedTarget>TmY4</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0247762</oboInOwl:hasDbXref>
    </owl:Axiom>
