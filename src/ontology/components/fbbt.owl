    <!-- http://purl.obolibrary.org/obo/UBERON_0000939 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000939">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000481"/>
        <obo:IAO_0000115>One of the parts of a holometabolous insect larva that will become a portion of the outside of the adult insect during the pupal transformation.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0004658</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FBbt:00001761</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MAT:0000064</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D060227</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIAA:0000064</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Imaginal_disc</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>imaginal disk</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0000939</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:comment>Though inaginal discs are sometimes described as “epithelial sacs”, we do not classify them as such, because an “epithelial sac” is defined in Uberon as being a single epithelium, whereas imaginal discs are made of several epithelia with distinct properties.</rdfs:comment>
        <rdfs:label>imaginal disc</rdfs:label>
    </owl:Class>
