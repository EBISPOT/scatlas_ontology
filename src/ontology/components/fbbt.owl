        <oboInOwl:hasDbXref>MA:0002402</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C53073</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0224444</oboInOwl:hasDbXref>
