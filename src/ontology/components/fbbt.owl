        <oboInOwl:hasDbXref>HAO:0001007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000411</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MAT:0000132</oboInOwl:hasDbXref>
