        <oboInOwl:hasDbXref>Wikipedia:Palatine_uvula</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>palatine uvula</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>uvula</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>uvula of palate</oboInOwl:hasExactSynonym>
