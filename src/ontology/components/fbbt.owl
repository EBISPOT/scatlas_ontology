    <!-- http://purl.obolibrary.org/obo/UBERON_0002370 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002370">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000077"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002368"/>
