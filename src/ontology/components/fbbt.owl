        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000116"/>
        <owl:annotatedTarget>This class is currently a mixed bag, encompassing (1) the entirety of the mammalian aorta together with (2) the developmental and phylogenetic homologs of its segments: the ventral aorta and dorsal aortae.</owl:annotatedTarget>
        <oboInOwl:source>WP</oboInOwl:source>
