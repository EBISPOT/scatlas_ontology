        <oboInOwl:hasDbXref>VFB:FBbt_00067064</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ORN (Gr21a)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ORN ab1C</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ORN_V</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult ORN Gr21a</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult olfactory receptor neuron Gr21a</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
