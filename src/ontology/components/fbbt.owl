        <oboInOwl:hasDbXref>SCTID:181277001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000140</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0030274</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000050</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Pancreas</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000136</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000140</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Pancreas</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
