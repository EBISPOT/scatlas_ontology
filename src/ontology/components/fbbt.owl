    <!-- http://purl.obolibrary.org/obo/FBbt_00100249 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00100249">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003686"/>
        <obo:IAO_0000115>Mushroom body neuron that is born during the late-larval stage, after the gamma neurons (Lee et al., 1999). Its axon bifurcates at the anterior end of the pedunculus, projecting into the medial and vertical lobes (Lee et al., 1999). During the pupal stage, it remains largely the same and forms the alpha&apos;/beta&apos; lobes of the adult (Lee et al., 1999).</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://www.researchgate.net/scientific-contributions/Simon-Reeve-2162827703"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-09-09T04:13:10Z</terms:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00100249</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>KCa&apos;b&apos;</oboInOwl:hasExactSynonym>
