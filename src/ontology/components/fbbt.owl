        <oboInOwl:hasDbXref>SCTID:244859003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0224307</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Longissimus#Longissimus_thoracis</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>longissimus dorsi</oboInOwl:hasExactSynonym>
