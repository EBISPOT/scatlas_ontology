    <!-- http://purl.obolibrary.org/obo/CL_0000394 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000394">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000387"/>
        <obo:IAO_0000115>A phagocytic hemocyte, responsible for the engulfment of small particles, microbes, and apoptotic tissue debris. It may also secretes antimicrobial peptides and contribute to the production and secretion of proteins of the hemolymph.</obo:IAO_0000115>
