        <obo:UBPROP_0000008>bipartite seminal vesicles, with a seminal gland and vesicular gland sharing a common duct are found in lagomorphs</obo:UBPROP_0000008>
        <oboInOwl:hasDbXref>BTO:0003717</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:19180</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000405</oboInOwl:hasDbXref>
