    <!-- http://purl.obolibrary.org/obo/UBERON_0004346 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004346">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004120"/>
