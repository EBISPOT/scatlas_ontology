        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>adult KC</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0227179</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FBbt_00049839 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00049839">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00047957"/>
