        <oboInOwl:hasDbXref>ZFA:0001260</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>endocrine pancreas</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pars endocrina pancreatis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>endocrine part of pancreas</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>islets of Langerhans part of pancreas</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0000016</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#organ_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
        <rdfs:label>endocrine pancreas</rdfs:label>
    </owl:Class>
