    <!-- http://purl.obolibrary.org/obo/CL_0000557 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000557">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000763"/>
