        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000101"/>
        <obo:IAO_0000115>A lobe of the lung that is situated somewhere between an upper lobe and lower lobe.</obo:IAO_0000115>
