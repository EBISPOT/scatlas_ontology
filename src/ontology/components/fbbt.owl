                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001277"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A T cell that is located in the intestinal epithelium and is capable of a mucosal immune response.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-12-07T09:54:50Z</oboInOwl:creation_date>
