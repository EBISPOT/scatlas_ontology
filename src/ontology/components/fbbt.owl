    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001011"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Blood analogue used by all arthropods and most mollusks that have an open circulatory system. In these animals there is no distinction between blood and interstitial fluid. The liquid fills all of the interior (the hemocoel) of the body and surrounds all cells.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Hemolymph</oboInOwl:hasDbXref>
