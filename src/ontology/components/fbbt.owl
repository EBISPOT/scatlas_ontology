        <obo:IAO_0000115>Tonsils on the left and right sides at the back of the throat. one of the mucosa-associated lymphoid tissues (MALT), located at the entrance to the upper respiratory and gastrointestinal tracts to protect the body from the entry of exogenous material through mucosal sites[WP].</obo:IAO_0000115>
        <obo:RO_0002174 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9989"/>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000011>tonsillar fossa develops from dorsal portion of pouch 2. Note that pharyngeal and lingual tonsils do not develop from pharyngeal pouches</obo:UBPROP_0000011>
        <oboInOwl:hasBroadSynonym>tonsil</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>BTO:0004714</oboInOwl:hasDbXref>
