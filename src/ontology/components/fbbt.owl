        <oboInOwl:hasExactSynonym>muscle of trunk</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>muscle organ of torso</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>muscle organ of trunk</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>torso muscle organ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>trunk muscle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>trunk muscle organ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>trunk musculature</oboInOwl:hasExactSynonym>
