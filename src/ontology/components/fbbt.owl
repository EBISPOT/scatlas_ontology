        <oboInOwl:hasDbXref>MESH:D005216</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIAA:0000096</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TADS:0000321</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TGMA:0001856</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>fat body</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>fat body sensu invertebrata</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0003917</oboInOwl:id>
