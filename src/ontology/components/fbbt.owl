    <!-- http://purl.obolibrary.org/obo/CL_0002437 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002437">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000625"/>
        <obo:IAO_0000115>A mature CD8-positive, CD4-negative alpha-beta T cell found in the thymus that is CD24-low and has high expression of the T cell receptor.</obo:IAO_0000115>
