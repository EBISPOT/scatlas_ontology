    <!-- http://purl.obolibrary.org/obo/CL_0000861 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000861">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000235"/>
        <obo:IAO_0000115>A macrophage which develops from an inflammatory monocyte and is recruited into the tissues in response to injury and infection as part of an inflammatory response. Markers include CD11b-positive, CD68-positive, and F4/80-positive.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:84643</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:84645</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>free macrophage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>wandering histiocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:comment>Markers: CD11b+, CD68+; Mouse: F4/80+; role or process: immune, inflammation (inflammatory response).</rdfs:comment>
        <rdfs:label>elicited macrophage</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000861"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A macrophage which develops from an inflammatory monocyte and is recruited into the tissues in response to injury and infection as part of an inflammatory response. Markers include CD11b-positive, CD68-positive, and F4/80-positive.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:add</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:ana</oboInOwl:hasDbXref>
