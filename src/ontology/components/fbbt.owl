        <oboInOwl:hasDbXref>SCTID:302522007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0038293</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000856</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Sternum</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Sternum</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>vertebrate sternum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>breastbone</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0000975</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:label>sternum</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/1/12/Illu_thoracic_cage.jpg</foaf:depiction>
    </owl:Class>
