    <!-- http://purl.obolibrary.org/obo/FBbt_00051494 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00051494">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00051173"/>
        <obo:IAO_0000115>Sensory neuron of the antenna that detects a stimulus via one or more receptors and projects to the antennal lobe (Schlegel et al., 2021). This includes antennal olfactory, thermosensory and hygrosensory neurons (Schlegel et al., 2021).</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-23T09:22:19Z</terms:date>
