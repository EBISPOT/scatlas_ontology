    <!-- http://purl.obolibrary.org/obo/CL_0000501 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000501">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000174"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002174"/>
        <obo:IAO_0000115>A supporting cell for the developing female gamete in the ovary of mammals. They develop from the coelomic epithelial cells of the gonadal ridge. Granulosa cells form a single layer around the mammalian oocyte in the primordial ovarian follicle and advance to form a multilayered cumulus oophorus surrounding the ovum in the Graafian follicle. The major functions of granulosa cells include the production of steroids and LH receptors.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0000542</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-0729</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:18718</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009227</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>granulosa cell of ovary</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>granulosa cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000501"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A supporting cell for the developing female gamete in the ovary of mammals. They develop from the coelomic epithelial cells of the gonadal ridge. Granulosa cells form a single layer around the mammalian oocyte in the primordial ovarian follicle and advance to form a multilayered cumulus oophorus surrounding the ovum in the Graafian follicle. The major functions of granulosa cells include the production of steroids and LH receptors.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MESH:D006107</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000501"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>ZFA:0009227</owl:annotatedTarget>
