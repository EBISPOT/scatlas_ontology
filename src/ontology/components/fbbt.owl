        <oboInOwl:hasDbXref>PMID:21849021</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:23303905</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
