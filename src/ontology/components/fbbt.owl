    <!-- http://purl.obolibrary.org/obo/UBERON_0003142 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003142">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000468"/>
        <obo:IAO_0000115>An organism at the prepupal stage. The prepupal stage is a life stage interposed between the larval and the pupal stages in insects that undergo a complete metamorphosis. The start of the pre-pupal stage is marked by pupariation, and the end is marked by pupation.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0001110</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FBbt:00002952</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HAO:0000812</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>UBERON:0003142</oboInOwl:id>
        <rdfs:label>prepupa</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003142"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An organism at the prepupal stage. The prepupal stage is a life stage interposed between the larval and the pupal stages in insects that undergo a complete metamorphosis. The start of the pre-pupal stage is marked by pupariation, and the end is marked by pupation.</owl:annotatedTarget>
