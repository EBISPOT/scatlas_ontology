    <!-- http://purl.obolibrary.org/obo/FBbt_00001303 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00001303">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001256"/>
        <obo:IAO_0000115>Glial cell of the CNS that is associated with neuropil compartments, including synaptic and tract neuropil (Hartenstein, 2011; Omoto et al., 2015; Kremer et al., 2017). These cells have their cell bodies located in the neuropil glial sheath, between the neuropil and the cell body rind, and many of them extend processes into the neuropil (Hartenstein, 2011; Omoto et al., 2015). Two subtypes have been identified, the reticular (astrocyte-like) and ensheathing glia (Hartenstein, 2011; Omoto et al., 2015), which both function in ionic and neurotransmitter homeostasis (Kremer et al., 2017).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>VFB:FBbt_00001303</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>neuropil associated CNS glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>neuropil associated glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>neuropil-associated CNS glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>neuropil-associated glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>neuropile glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00001303</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>neuropil glial cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001303"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Glial cell of the CNS that is associated with neuropil compartments, including synaptic and tract neuropil (Hartenstein, 2011; Omoto et al., 2015; Kremer et al., 2017). These cells have their cell bodies located in the neuropil glial sheath, between the neuropil and the cell body rind, and many of them extend processes into the neuropil (Hartenstein, 2011; Omoto et al., 2015). Two subtypes have been identified, the reticular (astrocyte-like) and ensheathing glia (Hartenstein, 2011; Omoto et al., 2015), which both function in ionic and neurotransmitter homeostasis (Kremer et al., 2017).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0082171</oboInOwl:hasDbXref>
