    <!-- http://purl.obolibrary.org/obo/CL_0002323 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002323">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000349"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001025"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000173"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cell of a fetus which is suspended in the amniotic fluid. Amniocytes are considered to arise from several tissues including fetal skin, the fetal urinary tract, umbilical cord, and the inner amniotic surface.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-09-20T10:13:37Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>BTO:0000066</oboInOwl:hasDbXref>
        <rdfs:label>amniocyte</rdfs:label>
    </owl:Class>
    <owl:Axiom>
