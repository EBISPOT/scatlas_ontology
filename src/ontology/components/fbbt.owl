        <oboInOwl:hasDbXref>VHOG:0000312</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Middle_ear</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000191</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
