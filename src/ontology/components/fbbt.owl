    <!-- http://purl.obolibrary.org/obo/UBERON_0005333 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005333">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005153"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010371"/>
        <obo:IAO_0000115>A bulb of epithelial cells that forms from the mammary placode that develops into the mammary gland.</obo:IAO_0000115>
        <obo:UBPROP_0000011>produced along the length of the embryonic mammary ridge these buds represent the future locations of the mammary glands. Invagination of ectoderm at each bud leads to the development of epithelial diverticula, later maturing as lactiferous ducts</obo:UBPROP_0000011>
        <oboInOwl:hasAlternativeId>UBERON:0004181</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>EMAPA:35536</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>lactiferous gland bud</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mammary gland bud</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>mammary primordium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>milk bud</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0005333</oboInOwl:id>
        <rdfs:label>mammary bud</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005333"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
