    <!-- http://purl.obolibrary.org/obo/UBERON_0010260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001981"/>
        <obo:IAO_0000115>One of the three blood vessels, usually one large umbilical vein and two small umbilical arteries, buried within Wharton&apos;s jelly, that transport blood to and from the placenta, where exchange between the mother and fetus takes place; the umbilical vein carries oxygenated, nutrient-rich blood from the placenta to the fetus, and the umbilical arteries carry deoxygenated, nutrient-depleted blood from the fetus to the placenta.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EMAPA:36493</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:408728001</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>allantoic vessel</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>umbilical cord blood vessel</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>umbilical vessel</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>umbilical cord blood vessels</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>umbilical vasculature</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0010260</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>umbilical blood vessel</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010260"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>One of the three blood vessels, usually one large umbilical vein and two small umbilical arteries, buried within Wharton&apos;s jelly, that transport blood to and from the placenta, where exchange between the mother and fetus takes place; the umbilical vein carries oxygenated, nutrient-rich blood from the placenta to the fetus, and the umbilical arteries carry deoxygenated, nutrient-depleted blood from the fetus to the placenta.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MP:0003230</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010260"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>allantoic vessel</owl:annotatedTarget>
