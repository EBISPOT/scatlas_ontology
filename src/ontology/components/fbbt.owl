        <rdfs:label>midgut</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/3/3d/Illu_small_intestine.jpg</foaf:depiction>
