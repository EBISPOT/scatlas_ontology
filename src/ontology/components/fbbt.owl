        <owl:annotatedTarget>adult flight muscle precursor cell</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0226374</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FBbt_00003232 -->

