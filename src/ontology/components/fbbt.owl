        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>EMAPA:37639</owl:annotatedTarget>
        <oboInOwl:source>MA:th</oboInOwl:source>
