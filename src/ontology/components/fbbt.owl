        <oboInOwl:hasDbXref>MESH:D042601</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C33038</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:279089004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0229889</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001249</oboInOwl:hasDbXref>
