        <owl:annotatedTarget>frontal association cortex</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MA:0000906</oboInOwl:hasDbXref>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/uberon/core#PENDING_REVIEW"/>
    </owl:Axiom>
