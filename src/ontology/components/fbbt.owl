    <!-- http://purl.obolibrary.org/obo/FBbt_00100505 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00100505">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001303"/>
        <obo:IAO_0000115>Neuropil associated glial cell of the central nervous system that has a dendritic morphology and elaborates inside the associated synaptic neuropil (Awasaki et al., 2008). Their nuclei are found at synaptic neuropil surfaces and they extend branched filiform or lamelliform processes that pervade the neuropil (Hartenstein, 2011). It expresses prospero, which specifies astrocyte-like, rather than ensheathing, fate in lineages that produce neuropil glia (Peco et al., 2016; Kato et al., 2020).</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://www.researchgate.net/scientific-contributions/Simon-Reeve-2162827703"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-04-26T04:23:17Z</terms:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00100505</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ALG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>astrocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>astrocyte-like neuropil associated glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>astrocytic glia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dendritic neuropil associated glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>reticular glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>reticular neuropil associated glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>reticular neuropil-associated glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00100505</oboInOwl:id>
        <rdfs:label>astrocyte-like glial cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
