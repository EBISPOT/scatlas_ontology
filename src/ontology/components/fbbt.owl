        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Nucleus of brain which is an elongated crescent-shaped mass lying parallel and adjacent to the lateral ventricle throughout its extent[FMA:61833].</owl:annotatedTarget>
        <oboInOwl:source>FMA:61833</oboInOwl:source>
