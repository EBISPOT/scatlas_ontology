    <!-- http://purl.obolibrary.org/obo/FBbt_00001327 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00001327">
        <obo:IAO_0000115>Glial cell in a nerve that is directly associated with its neurites and is not part of subperineurial layer that wraps the nerve. Early in development, cells of this type are involved in axon pathfinding. Later, cells of this type ensheath neurites and some are located at branching points.</obo:IAO_0000115>
        <obo:IAO_0100001 rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001320"/>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>PG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00001327</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:comment>Obsoleted as the definition (which sounds like the term refers to wrapping glial cells) does not match the name and the usage in literature (where the term is used to refer to all glial cells of the peripheral nervous system, not only wrapping glial cells).</rdfs:comment>
        <rdfs:label>obsolete peripheral glial cell</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001327"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Glial cell in a nerve that is directly associated with its neurites and is not part of subperineurial layer that wraps the nerve. Early in development, cells of this type are involved in axon pathfinding. Later, cells of this type ensheath neurites and some are located at branching points.</owl:annotatedTarget>
