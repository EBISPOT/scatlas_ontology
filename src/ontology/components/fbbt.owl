        <rdfs:label>medial dorsal nucleus of thalamus</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/1/1b/ThalamicNuclei.png</foaf:depiction>
