    <!-- http://purl.obolibrary.org/obo/FBbt_00110019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00110019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00051498"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00051849"/>
        <obo:IAO_0000115>Bilateral olfactory receptor neuron that expresses the ionotropic glutamate receptor (Ir) 64a (FBgn0035604) and the co-receptor Ir8a (FBgn0052704). Its axon branches, with one branch innervating an ipsilateral antennal lobe glomerulus and the other fasciculating with the antennal commissure and innervating the corresponding contralateral glomerulus. There are approximately 16 of these cells on each side and they can be split into two subtypes, one that innervates the DC4 glomerulus and one that innervates DP1m (Ai et al., 2010). Its dendrite transduces signals from the grooved sensillum of chamber III of the sacculus (Shanbhag et al., 1995).</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-5948-3092"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-11-03T01:56:34Z</terms:date>
        <oboInOwl:hasDbXref>FlyBrain_NDB:10388</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VFB:FBbt_00110019</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ORN (Dp1m)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ORN Ir64a</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ionotropic receptor neuron Ir64a</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00110019</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#olfactory_system_draft"/>
        <rdfs:label>adult olfactory receptor neuron Ir64a</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00110019"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Bilateral olfactory receptor neuron that expresses the ionotropic glutamate receptor (Ir) 64a (FBgn0035604) and the co-receptor Ir8a (FBgn0052704). Its axon branches, with one branch innervating an ipsilateral antennal lobe glomerulus and the other fasciculating with the antennal commissure and innervating the corresponding contralateral glomerulus. There are approximately 16 of these cells on each side and they can be split into two subtypes, one that innervates the DC4 glomerulus and one that innervates DP1m (Ai et al., 2010). Its dendrite transduces signals from the grooved sensillum of chamber III of the sacculus (Shanbhag et al., 1995).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0084361</oboInOwl:hasDbXref>
