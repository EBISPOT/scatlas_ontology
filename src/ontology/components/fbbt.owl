        <oboInOwl:id>FBbt:00067064</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#olfactory_system_draft"/>
        <rdfs:comment>Gr21a and Gr63a are only found in one ORN type and they are co-expressed (Kwon et al., 2006).</rdfs:comment>
        <rdfs:label>adult olfactory receptor neuron Gr21a/63a</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00067064"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Adult odorant receptor neuron that expresses Gr21a (FBgn0041250) (Couto et al., 2005) and Gr63a (FBgn0035468) (Kwon et al., 2007). It innervates only the ipsilateral antennal lobe glomerulus V (Kaur et al., 2019). It responds to CO2 levels (Suh et al., 2004; Kwon et al., 2007). Its dendrite transduces signals from antennal basiconic sensillum ab1. The numbers of these neurons have been estimated to 39.8 in females and 30 in males (Grabe et al., 2016).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>DoOR:Gr21a.Gr63a</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0051437</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0179739</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0187305</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0192797</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0233453</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0243918</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
