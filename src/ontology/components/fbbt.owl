    <!-- http://purl.obolibrary.org/obo/FBbt_00067016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00067016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00049977"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00051498"/>
        <obo:IAO_0000028>ORN_DC2</obo:IAO_0000028>
        <obo:IAO_0000115>Bilateral olfactory receptor neuron (ORN) that expresses Or13a (FBgn0030715). Its axon branches, with one branch innervating the ipsilateral antennal lobe glomerulus DC2 and the other fasciculating with the antennal commissure and innervating the contralateral antennal lobe glomerulus DC2. Its dendrite transduces signals from antennal basiconic sensillum ab6. There are approximately 15 of these cells in females and 11 in males, on each side (Grabe et al., 2016).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>DoOR:Or13a</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBrain_NDB:10393</oboInOwl:hasDbXref>
