        <oboInOwl:hasDbXref>UMLS:C1284058</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000541</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Ureteric_bud</oboInOwl:hasDbXref>
