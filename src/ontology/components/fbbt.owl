    <!-- http://purl.obolibrary.org/obo/FBbt_00047102 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00047102">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005736"/>
        <obo:IAO_0000115>Adult type II cell with a stellate morphology. These cells are found in the main segments of the Malpighian tubules (Denholm et al., 2013).</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-24T15:21:22Z</terms:date>
        <oboInOwl:hasExactSynonym>adult Malpighian tubule SC of main segment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult Malpighian tubule stellate Type II cell of main segment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00047102</oboInOwl:id>
        <rdfs:comment>The change in Type II cell shape from cuboidal to bar-shaped (initial and transitional segments) or stellate-shaped (main segment) occurs in the last 12h of pupal development (Denholm, 2013).</rdfs:comment>
        <rdfs:label>adult Malpighian tubule stellate cell of main segment</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00047102"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Adult type II cell with a stellate morphology. These cells are found in the main segments of the Malpighian tubules (Denholm et al., 2013).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0220823</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FBbt_00047103 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00047103">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005736"/>
        <obo:IAO_0000115>Adult type II cell with a bar-shaped morphology. These cells are found in the initial and transitional segments of the Malpighian tubules (Denholm et al., 2013).</obo:IAO_0000115>
