        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000075"/>
        <obo:IAO_0000115>An epithelial cell characterized by the presence of a brush border on its apical surface, which increases the surface area for absorption.</obo:IAO_0000115>
