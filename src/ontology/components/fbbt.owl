    <!-- http://purl.obolibrary.org/obo/UBERON_0001762 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001762">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002513"/>
