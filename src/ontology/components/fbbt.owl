        <oboInOwl:hasRelatedSynonym>postnatal subependymal plate</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>postnatal subependymal zone</oboInOwl:hasRelatedSynonym>
