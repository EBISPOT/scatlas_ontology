    <!-- http://purl.obolibrary.org/obo/CL_0000878 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000878">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000864"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002319"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
