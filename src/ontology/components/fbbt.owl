        <oboInOwl:hasDbXref>VHOG:0000052</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Duodenum</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000236</oboInOwl:hasDbXref>
