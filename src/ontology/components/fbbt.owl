        <oboInOwl:hasRelatedSynonym>adult proventriculus secretory cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00049283</oboInOwl:id>
        <rdfs:comment>These cells express Pgant4 (Hung et al., 2020).</rdfs:comment>
        <rdfs:label>adult midgut cell of proventriculus</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00049283"/>
