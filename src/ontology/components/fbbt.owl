    <!-- http://purl.obolibrary.org/obo/CL_0000599 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000599">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000605"/>
        <obo:IAO_0000115>An asexual, nonmotile spore formed by higher fungi; conidia are usually made from the side or tip of specialized sporogenous cells and do not form by progressive cleavage of the cytoplasm.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0000283</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FAO:0000024</oboInOwl:hasDbXref>
