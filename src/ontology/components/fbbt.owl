    <!-- http://purl.obolibrary.org/obo/UBERON_0004141 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003914"/>
