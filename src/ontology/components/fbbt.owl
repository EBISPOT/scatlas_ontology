        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#olfactory_system_draft"/>
        <rdfs:label>antennal trichoid sensillum at4</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00067010"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Olfactory trichoid sensillum of antennal segment 3 that houses the dendrites of ORNs Or47b and Or88a, with a subset additionally housing an ORN Or65a dendrite (Grabe et al., 2016; Gonzales et al., 2021). There are more of these sensilla in males than females (Grabe et al, 2016).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0187305</oboInOwl:hasDbXref>
