        <obo:IAO_0000115>Any adult Malpighian tubule bar-shaped cell (FBbt:00047103) that is part of some adult initial segment of Malpighian tubule (FBbt:00005729).</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-11T15:25:03Z</terms:date>
