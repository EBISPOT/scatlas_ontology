    <!-- http://purl.obolibrary.org/obo/CL_0000492 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000492">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000624"/>
        <obo:IAO_0000115>A CD4-positive, alpha-beta T cell that cooperates with other lymphocytes via direct contact or cytokine release to initiate a variety of immune functions.</obo:IAO_0000115>
