    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001305"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Oocyte development of zebrafish has been divided into five stages based on morphological criteria and on physiological and biochemical events. Stage I follicles (less than 140 microns) are primary growth stage, stage II follicles (140-340 microns) are cortical alveolus stage, stage III (340-690 microns) are vitellogenesis, stage IV (690-730 microns) are oocyte maturation, and stage V follicles are matured egg. Selman et al, 1993.[TAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-08-14</oboInOwl:date_retrieved>
