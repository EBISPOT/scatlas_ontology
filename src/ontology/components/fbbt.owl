    <!-- http://purl.obolibrary.org/obo/UBERON_8410081 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_8410081">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001981"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010523"/>
        <obo:IAO_0000115>Any of the smallest blood vessels where blood circulates within organ tissues. Microvessels include terminal arterioles, metarterioles, capillaries, and venules (but exclude lymphatic capillaries). Arterioles carry oxygenated blood to the capillaries, and blood flows out of the capillaries through venules into veins.</obo:IAO_0000115>
        <obo:UBPROP_0000007>microvascular</obo:UBPROP_0000007>
        <oboInOwl:created_by>http://orcid.org/0000-0002-2825-0621</oboInOwl:created_by>
        <oboInOwl:hasBroadSynonym>microvasculature</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>microvessel</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>UBERON:8410081</oboInOwl:id>
        <rdfs:label>blood microvessel</rdfs:label>
        <rdfs:seeAlso>https://github.com/obophenotype/uberon/issues/2186</rdfs:seeAlso>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_8410081"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any of the smallest blood vessels where blood circulates within organ tissues. Microvessels include terminal arterioles, metarterioles, capillaries, and venules (but exclude lymphatic capillaries). Arterioles carry oxygenated blood to the capillaries, and blood flows out of the capillaries through venules into veins.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Microcirculation</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>http://orcid.org/0000-0002-7073-9172</oboInOwl:hasDbXref>
    </owl:Axiom>
    


