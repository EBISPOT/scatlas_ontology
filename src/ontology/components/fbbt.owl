    <!-- http://purl.obolibrary.org/obo/FBbt_00003225 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00003225">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003219"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003233"/>
        <obo:IAO_0000115>Adepithelial cell associated with the wing imaginal disc. There are approximately 10 of these cells per wing disc at the end of embryogenesis; they proliferate throughout the larval stages to reach up to 2,500 cells by the late third instar larval stage. They give rise to the direct and indirect flight muscles of the adult (Gunage et al., 2014).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>FBbt:00100786</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>adepithelial cell of dorsal mesothoracic disc</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult flight muscle precursor cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00003225</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>adepithelial cell of wing disc</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003225"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Adepithelial cell associated with the wing imaginal disc. There are approximately 10 of these cells per wing disc at the end of embryogenesis; they proliferate throughout the larval stages to reach up to 2,500 cells by the late third instar larval stage. They give rise to the direct and indirect flight muscles of the adult (Gunage et al., 2014).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0093123</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0226374</oboInOwl:hasDbXref>
