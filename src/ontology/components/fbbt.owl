        <oboInOwl:hasDbXref>FlyBase:FBrf0222324</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0225094</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0241236</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003789"/>
