    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FBbt_02000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_02000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004227"/>
        <obo:IAO_0000028>yR8</obo:IAO_0000028>
        <obo:IAO_0000115>Photoreceptor cell R8 that is part of a yellow ommatidium and expresses Rhodopsin 6 (Wernet and Desplan, 2004). It outputs to TM5c, mostly in layer M3 where it terminates, but also in M1-2 (Karuppudurai et al., 2014) and to Tm20, Mi1, Mi4 and some lamina monopolar neurons of the same column (Takemura et al., 2015). It also outputs onto photoreceptor cell R7 of the same column (Takemura et al., 2008; Takemura et al., 2015), mostly in M3 (Takemura et al., 2008).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>VFB:FBbt_02000003</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>yR8</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:02000003</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:comment>Connectivity with TM5c inferred from GRASP experiments (Karuppudurai et al., 2014). Connectivity with R7, Mi1, Mi4, Tm20 and lamina monopolar neurons based on EM data (Takemura et al., 2008; Takemura et al., 2015). Assertion in Gao et al. (2008) - FBrf0206213 that (non-DRA) R8 is synapsed to Tm9 is not supported by EM data in Takemura et al. (2015).</rdfs:comment>
        <rdfs:label>photoreceptor cell R8 of yellow ommatidium</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_02000003"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000028"/>
        <owl:annotatedTarget>yR8</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0232800</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0252485</oboInOwl:hasDbXref>
    </owl:Axiom>
