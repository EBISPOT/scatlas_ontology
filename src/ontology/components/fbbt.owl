        <oboInOwl:hasDbXref>VHOG:0000683</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Cytotrophoblast</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cellular trophoblast</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cytotrophoblastic cell layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>Langhans&apos; layer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cytotrophoblastic cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cytotrophoblastus</oboInOwl:hasRelatedSynonym>
