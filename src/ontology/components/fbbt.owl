    <!-- http://purl.obolibrary.org/obo/CL_0000561 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000561">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000099"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0009004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000966"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Interneuron of the vertebrate retina. They integrate, modulate, and interpose a temporal domain in the visual message presented to the retinal ganglion cells, with which they synapse in the inner plexiform layer. They lack large axons.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref>BTO:0004044</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:67766</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009255</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>amacrine neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>AC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ACs</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#eye_upper_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
