    <!-- http://purl.obolibrary.org/obo/FBbt_00005382 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00005382">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100317"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001044"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001041"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Paired secretory organ connected to the atrium via the salivary duct. It is essentially composed of two cell types: cuboidal epithelial duct cells that form tubes connecting the secretory cells to the larval mouth; and secretory cells that synthesize and secrete high levels of protein (Andrew et al., 2000).</obo:IAO_0000115>
        <obo:IAO_0000589>saliva-secreting gland (drosophila)</obo:IAO_0000589>
        <oboInOwl:hasDbXref>UBERON:0001044</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
