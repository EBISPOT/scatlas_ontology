        <oboInOwl:hasDbXref>EMAPA:16800</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:295840</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:361485001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Nasal_pit</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000275</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0004073</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>nasal pit</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
