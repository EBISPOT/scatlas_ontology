    <!-- http://purl.obolibrary.org/obo/CL_0000525 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000525">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000228"/>
