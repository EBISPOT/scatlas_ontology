    <!-- http://purl.obolibrary.org/obo/CL_0019031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0019031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000160"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002563"/>
        <obo:IAO_0000115>Goblet cells reside throughout the length of the small and large intestine and are responsible for the production and maintenance of the protective mucus blanket by synthesizing and secreting high-molecular-weight glycoproteins known as mucins. Human intestinal goblet cells secrete the MUC2 mucin, as well as a number of typical mucus components: CLCA1, FCGBP, AGR2, ZG16, and TFF3.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-2034-601X"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-10-14T14:59:07Z</terms:date>
        <oboInOwl:hasExactSynonym>intestinal goblet cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label xml:lang="en">intestine goblet cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0019031"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Goblet cells reside throughout the length of the small and large intestine and are responsible for the production and maintenance of the protective mucus blanket by synthesizing and secreting high-molecular-weight glycoproteins known as mucins. Human intestinal goblet cells secrete the MUC2 mucin, as well as a number of typical mucus components: CLCA1, FCGBP, AGR2, ZG16, and TFF3.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:1996606</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:24942678</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0019031"/>
