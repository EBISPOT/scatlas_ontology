        <oboInOwl:hasExactSynonym>stretch cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stretched follicle cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
