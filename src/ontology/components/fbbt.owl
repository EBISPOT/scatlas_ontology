        <owl:annotatedTarget>pEC</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0244662</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FBbt_00007039 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00007039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007344"/>
        <obo:IAO_0000115>Wedge shaped diploid cell found in scattered clusters in the midgut epithelium. The broad end of the wedge lies on the basement membrane and contains the nucleus. The tapering apex of the cell extends up towards the lumen.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>ISC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00007039</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:comment>Can be identified by expression of Delta (and escargot) (Zeng and Hou, 2015).</rdfs:comment>
        <rdfs:label>intestinal stem cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
