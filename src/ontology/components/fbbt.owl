        <rdfs:label>nephron</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/0/02/Gray1128.png</foaf:depiction>
