    <!-- http://purl.obolibrary.org/obo/UBERON_0002691 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002691">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002616"/>
        <obo:IAO_0000115>Unpaired midbrain region situated in the ventromedial portion of the reticular formation. The VTA is medial to the substantia nigra and ventral to the red nucleus, and extends caudally from the posterior hypothalamus in the diencephalon. The VTA contains dopamine neurons that project to various limbic and cortical areas and is a critical component of the brain&apos;s reward circuitry.</obo:IAO_0000115>
        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001715"/>
        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001944"/>
        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001947"/>
        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001966"/>
        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002141"/>
        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002438"/>
        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002696"/>
        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002722"/>
