        <oboInOwl:notes>lampreys lack organized lymphoid tissue</oboInOwl:notes>
        <oboInOwl:source>NCBIBook:NBK27108</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001744"/>
