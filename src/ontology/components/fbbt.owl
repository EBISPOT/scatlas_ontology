        <owl:annotatedTarget>UMLS:C0007776</owl:annotatedTarget>
        <oboInOwl:source>BIRNLEX:1494</oboInOwl:source>
        <oboInOwl:source>ncithesaurus:Cortex</oboInOwl:source>
    </owl:Axiom>
