        <oboInOwl:hasDbXref>MAT:0000054</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D006458</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIAA:0000054</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TGMA:0000000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Hemolymph</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
