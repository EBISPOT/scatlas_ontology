        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00048378"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00049978"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00051498"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00052007"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00058202"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00058247"/>
        <obo:IAO_0000028>ORN_DA1</obo:IAO_0000028>
        <obo:IAO_0000115>Adult olfactory receptor neuron (ORN) that expresses OR67d (FBgn0036080). It also expresses fruitless (Yu et al., 2010). It innervates the antennal lobe glomerulus DA1 bilaterally, fasciculating with the antennal lobe commissure (Kaur et al., 2019). Its dendrite transduces signals from antennal trichoid sensillum at1 (Couto et al., 2005; Grabe et al., 2016). It responds to the male pheromone cis-vaccenyl acetate (cVA) (van der Goes et al., 2007). It expresses sNPF (Carlsson et al., 2010). There are approximately 62 of these cells on each side (Grabe et al., 2016).</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>adult fruitless SN-e neuron</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>adult fruitless fru-OSN neuron</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>DoOR:Or67d</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBrain_NDB:10416</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VFB:FBbt_00067031</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ORN (Or67d)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ORN at1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ORN at1A</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ORN_DA1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>T1A ORN</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult ORN Or67d</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>odorant receptor neuron OR67d</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>odorant receptor neuron DA1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00067031</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#olfactory_system_draft"/>
        <rdfs:comment>Work by Fishilevich and Vosshall (2005), suggested that some neurons of the class also innervated glomerulus VA2, but subsequent work showed this result to be an due to expression of the Or67d-GAL4 line used in a different ORN class (Fishilevich and Vosshall, 2007).</rdfs:comment>
        <rdfs:label>adult olfactory receptor neuron Or67d</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00067031"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Adult olfactory receptor neuron (ORN) that expresses OR67d (FBgn0036080). It also expresses fruitless (Yu et al., 2010). It innervates the antennal lobe glomerulus DA1 bilaterally, fasciculating with the antennal lobe commissure (Kaur et al., 2019). Its dendrite transduces signals from antennal trichoid sensillum at1 (Couto et al., 2005; Grabe et al., 2016). It responds to the male pheromone cis-vaccenyl acetate (cVA) (van der Goes et al., 2007). It expresses sNPF (Carlsson et al., 2010). There are approximately 62 of these cells on each side (Grabe et al., 2016).</owl:annotatedTarget>
