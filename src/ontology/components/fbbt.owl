        <obo:IAO_0000115>A dendritic cell of the myeloid lineage.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>interdigitating cell</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>veiled cell</oboInOwl:hasBroadSynonym>
