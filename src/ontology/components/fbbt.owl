        <owl:annotatedTarget>rib skeletal element</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://github.com/obophenotype/uberon/wiki/Modeling-endochondral-elements-Design-Pattern</oboInOwl:hasDbXref>
    </owl:Axiom>
