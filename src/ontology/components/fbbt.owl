        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#FlyTed"/>
        <rdfs:label>early elongation stage spermatid</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00057175"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
