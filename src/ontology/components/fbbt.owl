    <!-- http://purl.obolibrary.org/obo/FBbt_00067064 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00067064">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00049977"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00051499"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100045"/>
        <obo:IAO_0000028>ORN_V</obo:IAO_0000028>
        <obo:IAO_0000115>Adult odorant receptor neuron that expresses Gr21a (FBgn0041250) (Couto et al., 2005) and Gr63a (FBgn0035468) (Kwon et al., 2007). It innervates only the ipsilateral antennal lobe glomerulus V (Kaur et al., 2019). It responds to CO2 levels (Suh et al., 2004; Kwon et al., 2007). Its dendrite transduces signals from antennal basiconic sensillum ab1. The numbers of these neurons have been estimated to 39.8 in females and 30 in males (Grabe et al., 2016).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>FBbt:00100336</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>DoOR:Gr21a.Gr63a</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBrain_NDB:10390</oboInOwl:hasDbXref>
