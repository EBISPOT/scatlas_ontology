        <oboInOwl:hasDbXref>TAO:0002134</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0001527</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001284</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Adipose_tissue</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0003049</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005345</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:FattyTissue</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>fat</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fat tissue</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fatty tissue</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>adipose</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>bodyfat</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>fatty depot</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001013</oboInOwl:id>
