        <oboInOwl:hasRelatedSynonym>macula flava retinae</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>macula retinae</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>maculae</oboInOwl:hasRelatedSynonym>
