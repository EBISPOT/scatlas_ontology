    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000874">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000871"/>
        <obo:IAO_0000115>A splenic macrophage found in the red-pulp of the spleen, and involved in immune responses to blood-borne pathogens and in the clearance of senescent erythrocytes. Markers include F4/80-positive, CD68-positive, MR-positive, Dectin2-positive, macrosialin-positive, and sialoadhesin-low.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
