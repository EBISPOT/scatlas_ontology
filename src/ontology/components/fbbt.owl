    <!-- http://purl.obolibrary.org/obo/CL_0002489 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002489">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000893"/>
        <obo:IAO_0000115>A thymocyte that lacks expression of CD4 and CD8.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-12-06T03:03:38Z</oboInOwl:creation_date>
