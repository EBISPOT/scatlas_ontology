    <!-- http://purl.obolibrary.org/obo/UBERON_0001183 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001183">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005616"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0035039"/>
        <obo:IAO_0000115>Mesenteric artery that supplies the large intestine from the left colic (or splenic) flexure to the upper part of the rectum, which includes the descending colon, the sigmoid colon, and part of the rectum. Proximally, its territory of distribution overlaps (forms a watershed) with the middle colic artery, and therefore the superior mesenteric artery. The SMA and IMA anastomose via the marginal artery (artery of Drummond). The territory of distribution of the IMA is more or less equivalent to the embryonic hindgut. [WP,unvetted].</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasBroadSynonym>IMA</oboInOwl:hasBroadSynonym>
