    <!-- http://purl.obolibrary.org/obo/UBERON_0013126 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0013126">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001638"/>
