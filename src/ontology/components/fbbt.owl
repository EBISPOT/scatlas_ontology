    <!-- http://purl.obolibrary.org/obo/UBERON_0001894 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001894">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002616"/>
