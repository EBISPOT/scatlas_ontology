        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_1000450"/>
        <obo:IAO_0000115>A specialized kidney epithelial cell, contained within a glomerulus, that contains &quot;feet&quot; that interdigitate with the &quot;feet&quot; of other podocytes.</obo:IAO_0000115>
