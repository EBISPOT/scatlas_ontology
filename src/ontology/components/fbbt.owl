        <oboInOwl:hasDbXref>VHOG:0001281</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Myometrium</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>tunica muscularis (myometrium)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
