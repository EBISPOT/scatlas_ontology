    <!-- http://purl.obolibrary.org/obo/UBERON_0016525 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0016525">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016526"/>
        <obo:IAO_0000115>Frontal lobe is the anterior-most of five lobes of the cerebral hemisphere. It is bounded by the central sulcus on its posterior border and by the longitudinal cerebral fissure on its medial border.</obo:IAO_0000115>
        <obo:IAO_0000116>Many species don&apos;t have lobes but they do have frontal cortex. Lobe isn&apos;t a really well defined term though</obo:IAO_0000116>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasBroadSynonym>frontal region</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>regio frontalis</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>BAMS:Frontal_lobe</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BIRNLEX:928</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BM:Tel-Cx-FR</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-0389</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:12113</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EFO:0000913</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EV:0100167</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:61824</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:4009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MAT:0000505</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D005625</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12352</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:180920004</oboInOwl:hasDbXref>
