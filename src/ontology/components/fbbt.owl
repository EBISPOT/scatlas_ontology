        <oboInOwl:hasDbXref>MAT:0000015</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D000273</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIAA:0000015</oboInOwl:hasDbXref>
