    <!-- http://purl.obolibrary.org/obo/UBERON_0001322 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001322">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001021"/>
        <obo:IAO_0000115>A large nerve that supplies nearly the whole of the skin of the leg, the muscles of the back of the thigh, and those of the leg and foot. It begins in the lower back and runs through the buttock and down the lower limb.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000008>mouse sciatic nerve origins predominantly from the third lumbar (L3) and L4 spinal nerves, unlike the L4 and L5 in rats - http://www.ncbi.nlm.nih.gov/pmc/articles/PMC2700063/</obo:UBPROP_0000008>
