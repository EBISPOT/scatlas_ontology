        <oboInOwl:hasDbXref>MA:0000100</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000670</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0004139</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cardiac outflow tract</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>heart outflow tract</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>arterial (outflow) pole</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0004145</oboInOwl:id>
