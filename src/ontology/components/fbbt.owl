    <!-- http://purl.obolibrary.org/obo/FBbt_00005782 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00005782">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00047177"/>
        <obo:IAO_0000115>Large cell in the middle region of the midgut that is cup-shaped with long microvilli. These cells accumulate copper and secrete acid.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>cuprophilic cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00005782</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:comment>These cells can be distinguished from other enterocytes by their strong expression of labial in the larval and adult gut (Dubreuil et al., 2001).</rdfs:comment>
        <rdfs:label>copper cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005782"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Large cell in the middle region of the midgut that is cup-shaped with long microvilli. These cells accumulate copper and secrete acid.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0064792</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0100557</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0139611</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0174753</oboInOwl:hasDbXref>
    </owl:Axiom>
