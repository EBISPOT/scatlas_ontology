    <!-- http://purl.obolibrary.org/obo/UBERON_0006083 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006083">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002616"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000956"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Region of cortex near to the rhinal sulcus. It is defined differently in different nomenclatures, due in part to the lack of agreement on the definition of the border of this region. In the rat, the perirhinal cortex occupies only caudal levels of the rhinal sulcus while in the monkey, it occurpies the full rostrocaudal extent of the rhinal sulcus (Burwell et al., Hippocampus, 5: 390-408, 1995).</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000012>in MA classified as part of insular cortex, but this is contested by MM - https://support.crbs.ucsd.edu/browse/NIF-9830</obo:UBPROP_0000012>
        <oboInOwl:hasDbXref>BAMS:PERI</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:PRh</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BM:Tel-Cx-PRh</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BTO:0004355</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EFO:0001978</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:35682</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000912</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:922</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D000071039</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NLXANAT:1005006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PBA:128012080</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Perirhinal_cortex</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:2425</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>perirhinal area</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>perirhinal cortex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>Brodmann&apos;s area 35</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>area perirhinalis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>perihinal area</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0006083</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>perirhinal cortex</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006083"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Region of cortex near to the rhinal sulcus. It is defined differently in different nomenclatures, due in part to the lack of agreement on the definition of the border of this region. In the rat, the perirhinal cortex occupies only caudal levels of the rhinal sulcus while in the monkey, it occurpies the full rostrocaudal extent of the rhinal sulcus (Burwell et al., Hippocampus, 5: 390-408, 1995).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NLXANAT:1005006</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
