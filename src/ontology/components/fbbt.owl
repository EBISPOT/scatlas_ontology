        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>L-EG</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0234767</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005722"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>adult lamina ensheathing glial cell</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0234767</oboInOwl:hasDbXref>
