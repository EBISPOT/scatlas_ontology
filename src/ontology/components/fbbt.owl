        <oboInOwl:hasDbXref>MA:0001585</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D010306</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12427</oboInOwl:hasDbXref>
