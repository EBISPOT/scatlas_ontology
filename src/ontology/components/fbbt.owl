        <oboInOwl:hasDbXref>BTO:0001656</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>nerve cord</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>true nerve cord</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>UBERON:0005053</oboInOwl:id>
        <rdfs:label>primary nerve cord</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/obophenotype/uberon/issues/691</rdfs:seeAlso>
