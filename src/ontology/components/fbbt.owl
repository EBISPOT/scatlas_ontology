    <!-- http://purl.obolibrary.org/obo/FBbt_00067057 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00067057">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00049978"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00051498"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00058247"/>
        <obo:IAO_0000028>ORN_VA1d</obo:IAO_0000028>
        <obo:IAO_0000115>Adult olfactory receptor neuron (ORN) that expresses Or88a (FBgn0038203). It innervates the antennal lobe glomerulus VA1d bilaterally, fasciculating with the antennal lobe commissure (Kaur et al., 2019). Its dendrite transduces signals from antennal trichoid sensillum at4 (Couto et al., 2005; Grabe et al., 2016). It responds to a pheromone secreted by males and females (van der Goes et al., 2007). There are approximately 20 of these cells in females and 26 in males, on each side (Grabe et al., 2016).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>DoOR:Or88a</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBrain_NDB:10427</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VFB:FBbt_00067057</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ORN (Or88a)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ORN at4X</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ORN_VA1d</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult ORN Or88a</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>odorant receptor neuron Or88a</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>odorant receptor neuron VA1d</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>ORN at4C</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>T2B ORN</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>T3C ORN</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>ORN at3c</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00067057</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#olfactory_system_draft"/>
        <rdfs:comment>ORN Or88a was previously designated as the &apos;C&apos; neuron in at4 sensilla with three neurons, despite soma being second largest, and is now also designated as the &apos;B&apos; neuron in at4 sensilla with two neurons (Gonzales et al., 2021 - FBrf0250923).</rdfs:comment>
        <rdfs:label>adult olfactory receptor neuron Or88a</rdfs:label>
    </owl:Class>
    <owl:Axiom>
