    <!-- http://purl.obolibrary.org/obo/UBERON_0010304 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010304">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006915"/>
        <obo:IAO_0000115>Stratified squamous epithelium is a stratified squamous epithelium, the cells of which synthesizes but does not accumulate keratin. Examples: epithelium of vagina, epithelium of wall of esophagus.</obo:IAO_0000115>
