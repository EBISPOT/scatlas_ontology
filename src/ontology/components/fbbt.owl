        <oboInOwl:hasDbXref>FlyBase:FBrf0222324</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0235353</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0252485</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003776"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Mi1</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0247762</oboInOwl:hasDbXref>
