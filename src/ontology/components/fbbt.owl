    <!-- http://purl.obolibrary.org/obo/FBbt_00004886 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00004886">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000023"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00057012"/>
        <obo:IAO_0000115>Female germline cell that develops from one of the 16 cyst cells (the presumptive oocyte) produced by a cystoblast. It matures in an egg chamber of the ovariole and will be released from the ovary as an egg.</obo:IAO_0000115>
        <obo:IAO_0000589>oocyte (drosophila)</obo:IAO_0000589>
        <oboInOwl:hasDbXref>CL:0000023</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00004886</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#RD"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#expressionslim_flybase_ribbon"/>
        <rdfs:label>oocyte</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004886"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Female germline cell that develops from one of the 16 cyst cells (the presumptive oocyte) produced by a cystoblast. It matures in an egg chamber of the ovariole and will be released from the ovary as an egg.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0021038</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FBbt_00004903 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00004903">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000036"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000255"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00006010"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00006030"/>
        <obo:IAO_0000115>Stem cell from which the follicle cells that envelop the germline cyst derive. They develop from the larval follicle stem cell progenitors (Slaidina et al., 2020). There are two follicle stem cells in each germarium, located at opposite sides of the lateral wall of the germarium, in between regions 2a and 2b (Reilein et al., 2017). Each follicle stem cell produces over 500 follicle cells from nine cell divisions (Airoldi et al., 2011).</obo:IAO_0000115>
        <obo:IAO_0000589>follicle stem cell (sensu Arthropoda) (drosophila)</obo:IAO_0000589>
        <oboInOwl:hasBroadSynonym>SSC</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>somatic stem cell</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>CL:0000441</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>FSC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>epithelial follicle stem cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00004903</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#RD"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:comment>Can be identified by expression of zfh1, Fas3 and low expression of Wnt4 (Rust et al., 2020).</rdfs:comment>
        <rdfs:label>follicle stem cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004903"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Stem cell from which the follicle cells that envelop the germline cyst derive. They develop from the larval follicle stem cell progenitors (Slaidina et al., 2020). There are two follicle stem cells in each germarium, located at opposite sides of the lateral wall of the germarium, in between regions 2a and 2b (Reilein et al., 2017). Each follicle stem cell produces over 500 follicle cells from nine cell divisions (Airoldi et al., 2011).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0084162</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0202474</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0209788</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0217092</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0235409</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0244767</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0247148</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004903"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>somatic stem cell</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0202474</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004903"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>FSC</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0207075</oboInOwl:hasDbXref>
    </owl:Axiom>
