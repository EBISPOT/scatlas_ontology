    <!-- http://purl.obolibrary.org/obo/UBERON_0000323 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000323">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000922"/>
        <obo:IAO_0000115>An embryo that is at the late embryonic stage; this stage covers late steps of the embryogenesis with a fully formed embryo still developing before birth or egg hatching.</obo:IAO_0000115>
        <obo:IAO_0000116>TODO - check fetus/embryo. WP: An embryo is a multicellular diploid eukaryote in its earliest stage of development, from the time of first cell division until birth, hatching, or germination. In humans, it is called an embryo until about eight weeks after fertilization (i.e. ten weeks LMP), and from then it is instead called a fetus.</obo:IAO_0000116>
        <obo:UBPROP_0000001>Fetal structure, which is a developmental form of a vertebrate animal at any given time point from 8 weeks of gestation to birth (or hatching). Examples: There is only one fetus[FMA:63919].</obo:UBPROP_0000001>
        <oboInOwl:hasDbXref>BTO:0000449</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-0360</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EFO:0001323</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FBbt:00005333</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:63919</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:552</oboInOwl:hasDbXref>
