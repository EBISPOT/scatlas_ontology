        <oboInOwl:hasDbXref>Wikipedia:Juxtaglomerular_apparatus</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>complexus juxtaglomerularis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>juxtaglomerular complex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>UBERON:0002303</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:label>juxtaglomerular apparatus</rdfs:label>
    </owl:Class>
