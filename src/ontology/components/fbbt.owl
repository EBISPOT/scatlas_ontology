    <!-- http://purl.obolibrary.org/obo/FBbt_00100502 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00100502">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001303"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100499"/>
        <obo:IAO_0000115>Glial cell of the adult that is associated with a neuropil of the brain. There are approximately 200 neuropil associated glial cells per hemisphere of the adult brain (Hartenstein, 2011).</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://www.researchgate.net/scientific-contributions/Simon-Reeve-2162827703"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-04-26T02:36:23Z</terms:date>
