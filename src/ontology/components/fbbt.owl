        <rdfs:label>cardia of stomach</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://upload.wikimedia.org/wikipedia/commons/3/33/Illu_stomach.jpg</foaf:depiction>
    </owl:Class>
