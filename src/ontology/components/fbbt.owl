    <!-- http://purl.obolibrary.org/obo/UBERON_0001885 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001885">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002616"/>
