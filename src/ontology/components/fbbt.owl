    <!-- http://purl.obolibrary.org/obo/FBbt_00051493 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00051493">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005125"/>
        <obo:IAO_0000115>Neuron of the central nervous system that has the majority of its inputs and outputs in close proximity within the same region of the neuropil. Some arbors may spread outside of the region, but without sufficient polarity to define the neuron as an input or output neuron.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-22T08:47:38Z</terms:date>
