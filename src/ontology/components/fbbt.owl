    <!-- http://purl.obolibrary.org/obo/CL_0000826 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000826">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000838"/>
        <obo:IAO_0000115>A progenitor cell of the B cell lineage, with some lineage specific activity such as early stages of recombination of B cell receptor genes, but not yet fully committed to the B cell lineage until the expression of PAX5 occurs.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasBroadSynonym>pre-pro B cell</oboInOwl:hasBroadSynonym>
