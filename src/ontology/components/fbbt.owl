    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00004942">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000018"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00057011"/>
        <obo:IAO_0000115>One of 64, post meiotic, haploid male germ cells in a spermatid cyst, connected to other spermatids by cytoplasmic bridges. The loss of these cytoplasmic bridge (individualisation) marks the end of the spermatid stage.</obo:IAO_0000115>
