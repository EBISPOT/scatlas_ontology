        <oboInOwl:hasExactSynonym>SVZ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult subventricular zone</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>brain subventricular zone</oboInOwl:hasExactSynonym>
