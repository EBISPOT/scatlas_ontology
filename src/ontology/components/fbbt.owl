        <obo:IAO_0000115>The pectoralis major is a thick, fan-shaped muscle, situated at the upper front of the chest wall. It makes up the bulk of the chest muscles in the male and lies under the breast in the female. Underneath the pectoralis major is the pectoralis minor, a thin, triangular muscle. [WP,unvetted].</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref>EHDAA2:0001424</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EHDAA:8311</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:18179</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:9627</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0002354</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C33284</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:181624003</oboInOwl:hasDbXref>
