    <!-- http://purl.obolibrary.org/obo/UBERON_0002113 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000489"/>
