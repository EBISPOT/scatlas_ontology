    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0001054">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000576"/>
        <obo:IAO_0000115>A monocyte that expresses CD14 and is negative for the lineage markers CD3, CD19, and CD20.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasNarrowSynonym>monocyte</oboInOwl:hasNarrowSynonym>
