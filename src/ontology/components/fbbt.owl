        <oboInOwl:hasDbXref>Wikipedia:Ventral_striatum</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:2341</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>striatum ventral region</oboInOwl:hasExactSynonym>
