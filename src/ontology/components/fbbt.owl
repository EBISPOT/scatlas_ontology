        <oboInOwl:hasExactSynonym>temporopolar area 38</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>temporopolar area 38 (H)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
