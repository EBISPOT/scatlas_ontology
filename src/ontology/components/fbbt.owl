        <oboInOwl:hasDbXref>SCTID:118760003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0042779</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Viscus</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0003034</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>visceral organ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>visceral organ system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>splanchnic tissue</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>viscera</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>visceral tissue</oboInOwl:hasRelatedSynonym>
