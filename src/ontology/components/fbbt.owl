        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>podocyte</rdfs:label>
        <rdfs:seeAlso>https://github.com/obophenotype/cell-ontology/issues/1460</rdfs:seeAlso>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000653"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A specialized kidney epithelial cell, contained within a glomerulus, that contains &quot;feet&quot; that interdigitate with the &quot;feet&quot; of other podocytes.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:tfm</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://doi.org/10.1101/2021.10.10.463829</oboInOwl:hasDbXref>
    </owl:Axiom>
