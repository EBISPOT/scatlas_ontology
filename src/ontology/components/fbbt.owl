        <rdfs:label>tail of pancreas</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/f/fe/Illu_pancreas_duodenum.jpg</foaf:depiction>
