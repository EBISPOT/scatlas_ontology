    <!-- http://purl.obolibrary.org/obo/CL_0002365 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002365">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002293"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002124"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An epithelial cell of the medullary thymus. This cell type expresses a diverse range of tissue-specific antigens. This promiscuous gene expression is a cell-autonomous property of medullary epithelial cells and is maintained during the entire period of thymic T cell output.</obo:IAO_0000115>
