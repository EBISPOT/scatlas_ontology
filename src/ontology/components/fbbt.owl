    <!-- http://purl.obolibrary.org/obo/FBbt_00048152 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00048152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00049613"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00051978"/>
        <obo:IAO_0000115>Gustatory receptor neuron of the labellum that responds to bitter stimuli and innervates a bitter-sensitive (short or intermediate) taste bristle. All of these cells express Gr66a, usually in combination with Gr32a, Gr33a and Gr89a (Weiss et al., 2011). Some of them also respond to high, aversive concentrations of salts (Liman et al., 2014; Freeman and Dahanukar, 2015; Jaeger et al., 2018). A subset also express TRPA1 and respond to hydrogen peroxide (Guntur et al., 2017).</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-12T10:16:47Z</terms:date>
        <oboInOwl:hasDbXref>FlyBrain_NDB:10281</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBrain_NDB:10283</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VFB:FBbt_00048152</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Gr66a neuron of the labellum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>bitter-sensing neuron of the labellum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>labellar taste bristle type B gustatory receptor neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>type B GRN of labellum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00048152</oboInOwl:id>
        <rdfs:label>bitter-sensing neuron of labellar taste bristle</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00048152"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Gustatory receptor neuron of the labellum that responds to bitter stimuli and innervates a bitter-sensitive (short or intermediate) taste bristle. All of these cells express Gr66a, usually in combination with Gr32a, Gr33a and Gr89a (Weiss et al., 2011). Some of them also respond to high, aversive concentrations of salts (Liman et al., 2014; Freeman and Dahanukar, 2015; Jaeger et al., 2018). A subset also express TRPA1 and respond to hydrogen peroxide (Guntur et al., 2017).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0212834</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0229299</oboInOwl:hasDbXref>
