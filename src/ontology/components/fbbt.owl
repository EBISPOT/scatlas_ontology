        <oboInOwl:hasDbXref>XAO:0000154</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:UrinaryBladder</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>vesica urinaria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>urocyst</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vesica</oboInOwl:hasRelatedSynonym>
