        <owl:annotatedTarget>Cavity for the articulation of the proximal bone of the hind limb.[AAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-06-20</oboInOwl:date_retrieved>
        <oboInOwl:external_class>AAO:0000770</oboInOwl:external_class>
        <oboInOwl:ontology>AAO</oboInOwl:ontology>
