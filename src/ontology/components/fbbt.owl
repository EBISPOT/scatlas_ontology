        <oboInOwl:hasDbXref>VHOG:0001278</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Cerebrospinal_fluid</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001626</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>CSF</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cerebral spinal fluid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>liquor cerebrospinalis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>spinal fluid</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001359</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
        <rdfs:label>cerebrospinal fluid</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001359"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A clear, colorless, bodily fluid, that occupies the subarachnoid space and the ventricular system around and inside the brain and spinal cord.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Cerebrospinal_fluid</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001359"/>
