        <oboInOwl:hasDbXref>Wikipedia:Vertebrate_trachea</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000118</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cartilaginous trachea</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vertebrate trachea</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>windpipe</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
