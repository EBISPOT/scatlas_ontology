        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:comment>Dorsal group derivative that acts on the forearm[Kardong]</rdfs:comment>
        <rdfs:label>triceps brachii</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://upload.wikimedia.org/wikipedia/commons/8/83/Triceps_brachii.png</foaf:depiction>
