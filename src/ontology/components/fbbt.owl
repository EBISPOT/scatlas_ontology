    <!-- http://purl.obolibrary.org/obo/FBbt_00067059 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00067059">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00049977"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00051498"/>
        <obo:IAO_0000028>ORN_VA2</obo:IAO_0000028>
        <obo:IAO_0000115>Bilateral olfactory receptor neuron (ORN) that expresses Or92a (FBgn0038798). Its axon branches, with one branch innervating the ipsilateral antennal lobe glomerulus VA2 and the other fasciculating with the antennal commissure and innervating the contralateral antennal lobe glomerulus VA2. Its dendrite transduces signals from antennal basiconic sensillum ab1. There are approximately 44 of these cells in females and 32 in males, on each side (Grabe et al., 2016).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>DoOR:Or92a</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBrain_NDB:10428</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VFB:FBbt_00067059</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ORN (Or92a)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ORN ab1B</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ORN_VA2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult ORN Or92a</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>odorant receptor neuron Or92a</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>odorant receptor neuron VA2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00067059</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#olfactory_system_draft"/>
        <rdfs:label>adult olfactory receptor neuron Or92a</rdfs:label>
    </owl:Class>
    <owl:Axiom>
