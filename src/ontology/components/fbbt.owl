        <oboInOwl:hasDbXref>TAO:0000123</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0023884</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000257</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Liver</oboInOwl:hasDbXref>
