    <!-- http://purl.obolibrary.org/obo/UBERON_0005053 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004121"/>
