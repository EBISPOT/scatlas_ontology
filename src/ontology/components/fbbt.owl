    <!-- http://purl.obolibrary.org/obo/FBbt_00005184 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00005184">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007232"/>
        <obo:IAO_0000115>A sensillum of which the external part is a seta.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>VFB:FBbt_00005184</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>sensillum trichodeum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>hair sensillum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00005184</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:comment>Note that there is some variation in usage of this term throughout entomology, with some sources using it to refer to any sensillum with a hair or bristle cuticular specialization (e.g. see Chapman, 1998 FBrf0239230). Among the Dmel model organism community it is only used for the smallest of hairs/bristle, with sensilla with larger, thicker cuticular specializations being referred to as chaetae. We follow this usage. It should be noted, however, that there is no clear dividing line between macrochaeta and microchaeta or between microchaeta and trichoid sensillum.</rdfs:comment>
        <rdfs:label>trichoid sensillum</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005184"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sensillum of which the external part is a seta.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0111704</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0239230</oboInOwl:hasDbXref>
    </owl:Axiom>
    


