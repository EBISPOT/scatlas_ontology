        <oboInOwl:hasDbXref>SCTID:83418008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0015965</oboInOwl:hasDbXref>
        <oboInOwl:hasNarrowSynonym>fetus</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>embryo late growth stage</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>embryo late stage</oboInOwl:hasRelatedSynonym>
