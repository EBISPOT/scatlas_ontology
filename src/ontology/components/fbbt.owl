        <oboInOwl:hasDbXref>EMAPA:17490</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:24964</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:47</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000045</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D006615</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C64193</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:302543008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0019552</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000346</oboInOwl:hasDbXref>
