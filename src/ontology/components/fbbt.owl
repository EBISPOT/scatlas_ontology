        <rdfs:label>penis</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/8/87/Labelled_flaccid_penis.jpg</foaf:depiction>
    </owl:Class>
