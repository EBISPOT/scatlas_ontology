    <!-- http://purl.obolibrary.org/obo/FBbt_00067031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00067031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002167"/>
