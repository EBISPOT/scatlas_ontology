    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000578 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000578">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0001034"/>
        <obo:IAO_0000115>A cell in vitro that has undergone physical changes as a consequence of a deliberate and specific experimental procedure.</obo:IAO_0000115>
        <rdfs:comment>This class has been re-labeled to imply reference only to in vitro experimentally modified cells, similarly, the definition has been slightly updated to reflect this. &apos;experimentally modified cell&apos; refers only to cells in vitro, and not modified in vivo/in environment cells. There is currently no class representing unmodified in vitro cells (other than the parent &apos;cell in vitro&apos;), or a class representing modified native cells. More granular subclassing of experimentally modified cell can be found in ReO. MHB 1.12.12</rdfs:comment>
        <rdfs:label>experimentally modified cell in vitro</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000578"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cell in vitro that has undergone physical changes as a consequence of a deliberate and specific experimental procedure.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FB:ma</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ReO:mhb</oboInOwl:hasDbXref>
    </owl:Axiom>
    


