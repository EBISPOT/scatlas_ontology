        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0001054"/>
        <obo:IAO_0000115>A CD14-positive monocyte that is also CD16-positive and CCR2-negative.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
