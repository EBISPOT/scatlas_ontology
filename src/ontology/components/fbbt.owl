        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:comment>Can be identified based on coexpression of dpp and cv-2 (Rust et al., 2020).</rdfs:comment>
        <rdfs:label>stretch follicle cell</rdfs:label>
    </owl:Class>
