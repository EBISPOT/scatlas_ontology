    <!-- http://purl.obolibrary.org/obo/UBERON_0007358 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007358">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011953"/>
        <obo:IAO_0000115>The fourth stomach of ruminating animals, which is an elongated pear-shaped sac lying on the floor of the abdomen, on the right-hand side, and roughly between the seventh and twelfth ribs. It leads to the beginning of the small intestine. (Adapted From Black&apos;s Veterinary Dictionary, 17th ed).</obo:IAO_0000115>
