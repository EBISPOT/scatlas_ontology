        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002722"/>
        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002995"/>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasBroadSynonym>CGMB</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>griseum centrale</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>substantia grisea centralis</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>BAMS:CGMB</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:PAG</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BIRNLEX:973</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BM:MB-PAG</oboInOwl:hasDbXref>
