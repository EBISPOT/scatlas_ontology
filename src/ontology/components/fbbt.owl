        <oboInOwl:hasDbXref>FMA:72248</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:596</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:4697</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000199</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:528</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D002525</oboInOwl:hasDbXref>
