    <!-- http://purl.obolibrary.org/obo/FBbt_00057169 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00057169">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005286"/>
        <obo:IAO_0000115>Late, fully grown primary spermatocyte with a large central nucleus, blocky in appearance, often with indentations or grooves, containing Y-loops and a prominent nucleolus. The second nuclear membrane is fully formed. It has a highly developed endoplasmic reticulum, with mitochondria between the cisternae.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>apolar spermatocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00057169</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#FT_new"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#FlyTed"/>
        <rdfs:label>mature primary spermatocyte</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00057169"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Late, fully grown primary spermatocyte with a large central nucleus, blocky in appearance, often with indentations or grooves, containing Y-loops and a prominent nucleolus. The second nuclear membrane is fully formed. It has a highly developed endoplasmic reticulum, with mitochondria between the cisternae.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0064778</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00057169"/>
