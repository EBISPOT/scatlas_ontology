        <oboInOwl:hasDbXref>SCTID:361729006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Diaphysis</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>body of long bone</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>long bone diaphysis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>shaft of long bone</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>UBERON:0004769</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:label>diaphysis</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/9/94/Illu_long_bone.jpg</foaf:depiction>
    </owl:Class>
