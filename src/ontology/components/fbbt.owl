    <!-- http://purl.obolibrary.org/obo/FBbt_00048274 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00048274">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001983"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00058257"/>
        <obo:IAO_0000115>Mechanosensory neuron that innervates a scolopidium of a chordotonal organ in the leg. These neurons have axon terminals in a stratum of the leg neuropil that partially overlaps the terminals of campaniform sensillum neurons and is relatively dorsal compared to the terminals of other somatosensory neurons (Tsubouchi et al., 2017).</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-04-15T09:30:30Z</terms:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00048274</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Lco1N</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>leg chordotonal neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>leg chordotonal organ primary neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00048274</oboInOwl:id>
        <rdfs:comment>Tsubouchi et al., 2017 have a diagram showing tibial chordotonal receptor neurons, but they do not clearly show these among their example neurons (Lco1N1 and Lco1N2).</rdfs:comment>
        <rdfs:label>mechanosensory neuron of leg chordotonal organ</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00048274"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Mechanosensory neuron that innervates a scolopidium of a chordotonal organ in the leg. These neurons have axon terminals in a stratum of the leg neuropil that partially overlaps the terminals of campaniform sensillum neurons and is relatively dorsal compared to the terminals of other somatosensory neurons (Tsubouchi et al., 2017).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0237124</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
