        <oboInOwl:hasDbXref>UMLS:C0231051</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000285</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Foregut</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000232</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
