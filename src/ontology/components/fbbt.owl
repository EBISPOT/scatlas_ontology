        <oboInOwl:hasRelatedSynonym>palate</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0012316</oboInOwl:id>
        <rdfs:label>primitive palate</rdfs:label>
    </owl:Class>
