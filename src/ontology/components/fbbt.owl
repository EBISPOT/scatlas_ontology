        <oboInOwl:hasDbXref>CALOHA:TS-1106</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:67755</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>vascular endothelial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>cubodial endothelial cell of vascular tree</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:comment>These cells are reportedly CD31-positive, CD34-positive, CD144-positive, TAL1-positive.</rdfs:comment>
