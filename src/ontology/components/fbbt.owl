    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000792">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000624"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000815"/>
        <obo:IAO_0000115>A CD4-positive, CD25-positive, alpha-beta T cell that regulates overall immune responses as well as the responses of other T cell subsets through direct cell-cell contact and cytokine release.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>Treg</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>suppressor T cell</oboInOwl:hasBroadSynonym>
