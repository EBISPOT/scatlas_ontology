    <!-- http://purl.obolibrary.org/obo/CL_0000542 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000542">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000842"/>
        <obo:IAO_0000115>A lymphocyte is a leukocyte commonly found in the blood and lymph that has the characteristics of a large nucleus, a neutral staining cytoplasm, and prominent heterochromatin.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref>BTO:0000775</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-0583</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:62863</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D008214</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001535</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009250</oboInOwl:hasDbXref>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:comment>Editors note: consider adding taxon constraint to vertebrata (PMID:18025161)</rdfs:comment>
