        <oboInOwl:hasRelatedSynonym>gemma ureterica</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>metanephric bud</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>metanephric diverticulum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ureteric ampulla</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ureteric diverticulum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0000084</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>ureteric bud</rdfs:label>
    </owl:Class>
