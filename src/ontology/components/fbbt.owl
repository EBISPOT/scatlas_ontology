        <oboInOwl:hasDbXref>FMA:271593</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Posterior_cingulate</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>cingulate gyrus, posterior division</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>posterior cingular cortex</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0022353</oboInOwl:id>
        <rdfs:label>posterior cingulate cortex</rdfs:label>
    </owl:Class>
