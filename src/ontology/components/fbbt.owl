        <oboInOwl:hasDbXref>UMLS:C0024890</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Muscles_of_mastication</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>muscle of mastication</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>jaw muscle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>musculi masticatorii</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0003681</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
