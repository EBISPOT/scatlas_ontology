        <oboInOwl:hasDbXref>MAT:0000146</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D004432</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIAA:0000146</oboInOwl:hasDbXref>
