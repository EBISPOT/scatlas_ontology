    <!-- http://purl.obolibrary.org/obo/UBERON_0001630 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001630">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000062"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005090"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001015"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Organ consisting of a tissue made up of various elongated cells that are specialized to contract and thus to produce movement and mechanical work[GO].</obo:IAO_0000115>
        <obo:UBPROP_0000001>Portion of tissue composed of contractile fibers.[TAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000003>It seems clear that the metazoan ancestor inherited from its unicellular descendants an actin cytoskeleton and motor-proteins of the myosin superfamily. Within metazoans, these two molecules were arranged into effective contractile units, the muscles. The basic trends for muscle evolution are already expressed in the diploblastic taxa.[well established][VHOG]</obo:UBPROP_0000003>
        <obo:UBPROP_0000007>muscular</obo:UBPROP_0000007>
        <oboInOwl:hasBroadSynonym>muscle</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>EMAPA:37474</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EV:0100146</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:5022</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:131</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000015</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:71616004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0005145</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001245</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000172</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005145</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Muscle</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>UBERON:0001630</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#organ_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
        <rdfs:label>muscle organ</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001630"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Organ consisting of a tissue made up of various elongated cells that are specialized to contract and thus to produce movement and mechanical work[GO].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GO:0007517</oboInOwl:hasDbXref>
    </owl:Axiom>
