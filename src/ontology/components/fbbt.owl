        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0008007"/>
        <obo:IAO_0000115>A non-striated, elongated, spindle-shaped cell found lining the digestive tract, uterus, and blood vessels. They develop from specialized myoblasts (smooth muscle myoblast).</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasBroadSynonym>non-striated muscle cell</oboInOwl:hasBroadSynonym>
