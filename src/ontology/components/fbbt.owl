    <!-- http://purl.obolibrary.org/obo/CL_0001051 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0001051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000624"/>
        <obo:IAO_0000115>A CD4-positive, alpha-beta T cell that has the phenotype CXCR3-negative, CCR6-negative.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>non-Th1/Th17 CD4+ T cell</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>CD4-positive, CXCR3-negative, CCR6-negative, alpha-beta T lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>CD4-positive, CXCR3-negative, CCR6-negative, alpha-beta T-cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>CD4-positive, CXCR3-negative, CCR6-negative, alpha-beta T-lymphocyte</oboInOwl:hasExactSynonym>
        <rdfs:comment>This cell type is compatible with the HIPC Lyoplate markers for &apos;non-Th1/Th17 CD4+ T cell&apos;.  Cells of this phenotype may include T-helper 2 T cells and some naive CD4+ T cells.</rdfs:comment>
        <rdfs:label>CD4-positive, CXCR3-negative, CCR6-negative, alpha-beta T cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
