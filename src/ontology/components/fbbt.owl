    <!-- http://purl.obolibrary.org/obo/FBbt_00003817 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00003817">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003788"/>
        <obo:IAO_0000028>TmY</obo:IAO_0000028>
        <obo:IAO_0000115>An intrinsic columnar neuron of the optic lobe whose cell body lies in the distal cortex of the medulla and that arborizes in the medulla and branches in the second optic chiasm with one branch innervating the lobula and the other the lobula plate.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>VFB:FBbt_00003817</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>TmY</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00003817</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>transmedullary Y neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
