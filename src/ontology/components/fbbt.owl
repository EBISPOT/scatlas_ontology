        <oboInOwl:hasNarrowSynonym>exocrine duct</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>exocrine gland duct</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
