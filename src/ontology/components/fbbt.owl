    <!-- http://purl.obolibrary.org/obo/FBbt_00058291 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00058291">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100313"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000055"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004120"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001009"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A contractile tube located underneath the dorsal epidermis. It ensures the hemolymph circulates within the hemocoel, by letting the hemolymph enter the tube through lateral slits (ostia) in the posterior end and pumping it back into the hemocoel (Rotstein and Paululat, 2016).</obo:IAO_0000115>
        <obo:IAO_0000589>circulatory system dorsal vessel (drosophila)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-6095-8718"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-12-08T15:32:57Z</terms:date>
        <oboInOwl:hasDbXref>UBERON:0015231</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00058291</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>dorsal vessel</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00058291"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A contractile tube located underneath the dorsal epidermis. It ensures the hemolymph circulates within the hemocoel, by letting the hemolymph enter the tube through lateral slits (ostia) in the posterior end and pumping it back into the hemocoel (Rotstein and Paululat, 2016).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0238157</oboInOwl:hasDbXref>
    </owl:Axiom>
    


