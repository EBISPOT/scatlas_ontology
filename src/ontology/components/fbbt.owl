    <!-- http://purl.obolibrary.org/obo/UBERON_0007365 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007365">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011954"/>
        <obo:IAO_0000115>The first compartment of the ruminant stomach. It lies on the left side of the body, occupying the whole of the left side of the abdomen and even stretching across the median plane of the body to the right side. It is capacious, divided into an upper and a lower sac, each of which has a blind sac at its posterior extremity.</obo:IAO_0000115>
        <obo:UBPROP_0000007>ruminal</obo:UBPROP_0000007>
        <obo:UBPROP_0000009>Coarse, partially chewed food is stored and churned in the rumen until the animal finds circumstances convenient for rumination. When this occurs, little balls of food are regurgitated through the esophagus into the mouth, and are subjected to a second more thorough mastication, swallowed, and passed on into other parts of the compound stomach. (From Black&apos;s Veterinary Dictionary, 17th ed)</obo:UBPROP_0000009>
        <obo:UBPROP_0000010>There is no muscularis mucosae in the rumen. The rumen is lined by mucous membrane containing no digestive glands, but mucus-secreting glands are present in large numbers</obo:UBPROP_0000010>
        <oboInOwl:hasDbXref>BTO:0001194</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:1244</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D012417</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C98778</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:45138000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0035946</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Rumen</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>paunch</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0007365</oboInOwl:id>
        <rdfs:label>rumen</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://upload.wikimedia.org/wikipedia/commons/2/2b/Abomasum_(PSF).png</foaf:depiction>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007365"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The first compartment of the ruminant stomach. It lies on the left side of the body, occupying the whole of the left side of the abdomen and even stretching across the median plane of the body to the right side. It is capacious, divided into an upper and a lower sac, each of which has a blind sac at its posterior extremity.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MESH:A13.869.804</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Rumen</oboInOwl:hasDbXref>
    </owl:Axiom>
