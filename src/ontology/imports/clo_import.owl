SubClassOf(<http://purl.obolibrary.org/obo/CLO_0000012> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0001000> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CL_0000084> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/NCBITaxon_9606>))))

# Class: <http://purl.obolibrary.org/obo/CLO_0000019> (immortal cell line cell)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CLO_0000019> "A cell line cell that is expected to be capable of an unlimited number of divisions, and is thus able to support indefinite propagation in vitro as part of an immortal cell line.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CLO_0000019> "immortal cell line cell")
SubClassOf(<http://purl.obolibrary.org/obo/CLO_0000019> <http://purl.obolibrary.org/obo/CLO_0000001>)

