############################
#   Object Properties
############################

# Object Property: <http://purl.obolibrary.org/obo/CLO_0000015> (derives from patient having disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CLO_0000015> "a 'derives from' object property between an entity (in CLO case, cell line) and a  disease in a patient where the entity is derived from some cell in the patient who has the disease. 
This is a short cut relation that represents:
'derived from' some (cell and ('part of' some 'organism' and ('has disease' some disease)))")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CLO_0000015> "derives from patient having disease"@en)
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/CLO_0000015> <http://purl.obolibrary.org/obo/RO_0001000>)

# Object Property: <http://purl.obolibrary.org/obo/CLO_0000167> (has disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CLO_0000167> "a disease disposition has been realized by a bearer.
")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CLO_0000167> "has disease"@en)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/CLO_0000167> <http://purl.obolibrary.org/obo/OBI_0100026>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/CLO_0000167> <http://purl.obolibrary.org/obo/DOID_4>)

# Object Property: <http://purl.obolibrary.org/obo/CLO_0000179> (is disease model for)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CLO_0000179> "an object property that represents a relation between a cell line cell and a disease.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CLO_0000179> "is disease model for"@en)
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/CLO_0000179> owl:topObjectProperty)

# Object Property: <http://purl.obolibrary.org/obo/CLO_0037208> (derived from anatomic part)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CLO_0037208> "a 'derives from' object property between an entity (i.e., cell line cell in CLO) and an anatomic part from an organism  where the cell line cell is derived from some cell in the anatomic part (e.g., tissue or organ). The anatomic part is typically defined by UBERON in CLO. 
in CLO, this is a short cut relation that represents:
'derived from' some (cell and ('part of' some 'anatomic part'))")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CLO_0037208> "derived from anatomic part"@en)
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/CLO_0037208> <http://purl.obolibrary.org/obo/RO_0001000>)



############################
#   Classes
############################

# Class: <http://purl.obolibrary.org/obo/CLO_0000000> (cell line cell culturing)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CLO_0000000> "a maintaining cell culture process that keeps cell line cell alive and actively cultured.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CLO_0000000> "cell line cell culturing")
SubClassOf(<http://purl.obolibrary.org/obo/CLO_0000000> <http://purl.obolibrary.org/obo/OBI_0600024>)
SubClassOf(<http://purl.obolibrary.org/obo/CLO_0000000> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/OBI_0000293> <http://purl.obolibrary.org/obo/CLO_0000031>))
SubClassOf(<http://purl.obolibrary.org/obo/CLO_0000000> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/OBI_0000299> <http://purl.obolibrary.org/obo/CLO_0000031>))

# Class: <http://purl.obolibrary.org/obo/CLO_0000001> (cell line cell)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CLO_0000001> "A cultured cell that is part of a cell line - a stable and homogeneous population of cells with a common biological origin and propagation history in culture"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CLO_0000001> "A cultured cell that is part of a cell line - a stable and homogeneous population of cells with a common biological origin and propagation history in culture
")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CLO_0000001> "cell line cell")
SubClassOf(<http://purl.obolibrary.org/obo/CLO_0000001> <http://purl.obolibrary.org/obo/CL_0000010>)
SubClassOf(<http://purl.obolibrary.org/obo/CLO_0000001> <http://purl.obolibrary.org/obo/OBI_0001866>)
SubClassOf(<http://purl.obolibrary.org/obo/CLO_0000001> ObjectUnionOf(ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/OBI_0000312> <http://purl.obolibrary.org/obo/OBI_0001867>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0001000> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/OBI_0000312> <http://purl.obolibrary.org/obo/OBI_0001867>))))
SubClassOf(<http://purl.obolibrary.org/obo/CLO_0000001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0001000> <http://purl.obolibrary.org/obo/CL_0000001>))

# Class: <http://purl.obolibrary.org/obo/CLO_0000002> (suspension cell line culturing)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CLO_0000002> "suspension cell line culturing is a cell line culturing method where cells do not require a surface for growth and differentiation. This method is appropriate for cells that are adapted to suspension culture or cells that are non-adhesive (e.g. hematopoietic cells)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CLO_0000002> "suspension cell line culturing")
SubClassOf(<http://purl.obolibrary.org/obo/CLO_0000002> <http://purl.obolibrary.org/obo/CLO_0000000>)
SubClassOf(<http://purl.obolibrary.org/obo/CLO_0000002> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000055> <http://purl.obolibrary.org/obo/CLO_0000029>))

# Class: <http://purl.obolibrary.org/obo/CLO_0000005> (cell line repository role)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CLO_0000005> "a role that inheres in a cell line repository organization.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CLO_0000005> "cell line repository role")
SubClassOf(<http://purl.obolibrary.org/obo/CLO_0000005> <http://purl.obolibrary.org/obo/BFO_0000023>)

# Class: <http://purl.obolibrary.org/obo/CLO_0000008> (cell line repository)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CLO_0000008> "an organization that serves as a repository of cell lines.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CLO_0000008> "cell line repository")
EquivalentClasses(<http://purl.obolibrary.org/obo/CLO_0000008> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/OBI_0000245> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/CLO_0000005>)))

# Class: <http://purl.obolibrary.org/obo/CLO_0000012> (immortal human T cell line cell)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CLO_0000012> "an immortal human lymphocyte cell line cell that is derived from T cell.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CLO_0000012> "immortal human T cell line cell"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/CLO_0000012> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CLO_0000108> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0001000> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CL_0000084> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/NCBITaxon_9606>)))))
