AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/RO_0002203> "inverse of develops from")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002203> "develops into"@en)
