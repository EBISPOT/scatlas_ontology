AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_83820> "non-proteinogenic amino acid")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_83820> <http://purl.obolibrary.org/obo/CHEBI_33709>)

