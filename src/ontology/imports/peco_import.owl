AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_83821> "amino-acid derivative")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_83821> <http://purl.obolibrary.org/obo/CHEBI_35352>)

