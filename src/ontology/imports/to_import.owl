AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_134179> "Any organic compound having an initial boiling point less than or equal to 250 °C (482 °F) measured at a standard atmospheric pressure of 101.3 kPa.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_134179> "volatile organic compound")
