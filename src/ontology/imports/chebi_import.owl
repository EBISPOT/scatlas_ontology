SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_64187> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/CHEBI_48560>))
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_64187> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/CHEBI_59321>))
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_64187> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0018033> <http://purl.obolibrary.org/obo/CHEBI_64190>))

