SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_134024> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/CHEBI_76413>))
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_134024> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/CHEBI_78298>))

