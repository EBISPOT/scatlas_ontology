# Class: <http://purl.obolibrary.org/obo/CHEBI_134045> (polychlorinated dibenzodioxines and related compounds)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_134045> "Organochlorine compounds that are polychlorinated dibenzodioxines and structurally related entities that are persistant organic pollutants. These include polychlorinated dibenzofurans as well as polychlorinated and polybrominated biphenyls  They vary widely in their toxicity, but their toxic mode of action is through the aryl hydrocarbon receptor.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_134045> "polychlorinated dibenzodioxines and related compounds")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_134045> <http://purl.obolibrary.org/obo/CHEBI_17792>)
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_134045> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/CHEBI_77853>))

# Class: <http://purl.obolibrary.org/obo/CHEBI_134091> (perfluorinated compound)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_134091> "An organofluorine compound containing only C-F bonds (no C-H bonds) and C-C bonds but also other heteroatoms (particularly other halogens, oxygen, and sulfur). Their properties represent a blend of fluorocarbons (containing only C-F and C-C bonds) and the parent functionalised organic species.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_134091> "perfluorinated compound")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_134091> <http://purl.obolibrary.org/obo/CHEBI_37143>)

# Class: <http://purl.obolibrary.org/obo/CHEBI_134179> (volatile organic compound)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_134179> "Any organic compound having an initial boiling point less than or equal to 250 °C (482 °F) measured at a standard atmospheric pressure of 101.3 kPa.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_134179> "volatile organic compound")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_134179> <http://purl.obolibrary.org/obo/CHEBI_72695>)

