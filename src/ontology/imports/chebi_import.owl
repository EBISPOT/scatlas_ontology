AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_35715> "nitro compound")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_35715> <http://purl.obolibrary.org/obo/CHEBI_51143>)
