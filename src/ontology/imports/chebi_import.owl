AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_35482> "A narcotic or opioid substance, synthetic or semisynthetic agent producing profound analgesia, drowsiness, and changes in mood.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_35482> "opioid analgesic")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_35482> <http://purl.obolibrary.org/obo/CHEBI_35480>)

